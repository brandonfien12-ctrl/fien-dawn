{% doc %}
  Renders a single media item — a Shopify-hosted video, an external
  (YouTube / Vimeo) video, or an image — with sensible fallbacks. Used by the
  landing, portfolio gallery and client gate sections so media rendering stays
  consistent in one place.

  Resolution order: hosted video → external video → image → placeholder.

  @param {video} [video] - A Shopify-hosted video (from a `video` setting)
  @param {link} [video_url] - An external video (from a `video_url` setting), exposes `.type` and `.id`
  @param {image} [image] - An image (from an `image_picker` setting)
  @param {string} [loading] - Image loading strategy: 'lazy' (default) or 'eager'
  @param {string} [title] - Optional visible title shown above the media
  @param {string} [caption] - Optional caption shown below the media

  @example
  {% render 'fien-media-item',
    image: block.settings.image,
    video: block.settings.video,
    video_url: block.settings.video_url,
    caption: block.settings.caption
  %}
{% enddoc %}

{%- liquid
  assign loading = loading | default: 'lazy'
-%}

<figure class="fien-media-item">
  {%- if title != blank -%}
    <figcaption class="fien-media-item__title">{{ title }}</figcaption>
  {%- endif -%}

  <div class="fien-media-item__frame">
    {%- if video != blank -%}
      {{
        video
        | video_tag:
          controls: true,
          playsinline: true,
          preload: 'metadata',
          class: 'fien-media-item__video'
      }}
    {%- elsif video_url != blank -%}
      {%- if video_url.type == 'youtube' -%}
        <iframe
          class="fien-media-item__embed"
          src="https://www.youtube.com/embed/{{ video_url.id }}"
          title="{{ title | default: caption | escape }}"
          loading="{{ loading }}"
          allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      {%- elsif video_url.type == 'vimeo' -%}
        <iframe
          class="fien-media-item__embed"
          src="https://player.vimeo.com/video/{{ video_url.id }}"
          title="{{ title | default: caption | escape }}"
          loading="{{ loading }}"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
        ></iframe>
      {%- endif -%}
    {%- elsif image != blank -%}
      {{
        image
        | image_url: width: 1600
        | image_tag:
          loading: loading,
          class: 'fien-media-item__image',
          widths: '400, 600, 800, 1000, 1200, 1600',
          sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw'
      }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'fien-media-item__placeholder' }}
    {%- endif -%}
  </div>

  {%- if caption != blank -%}
    <figcaption class="fien-media-item__caption">{{ caption }}</figcaption>
  {%- endif -%}
</figure>

{% stylesheet %}
  .fien-media-item {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .fien-media-item__frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--dark);
    border: 1px solid var(--border);
    transition: border-color 0.3s, transform 0.3s;
  }

  .fien-media-item__frame:hover {
    border-color: rgba(201, 168, 76, 0.3);
    transform: translateY(-4px);
  }

  .fien-media-item__image,
  .fien-media-item__video {
    display: block;
    width: 100%;
    height: auto;
  }

  .fien-media-item__embed {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
  }

  .fien-media-item__placeholder {
    display: block;
    width: 100%;
    height: auto;
    background: var(--mid);
  }

  .fien-media-item__title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    letter-spacing: 0.04em;
    color: var(--white);
    margin: 0 0 12px;
  }

  .fien-media-item__caption {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    color: var(--muted);
    margin: 16px 0 0;
    line-height: 1.6;
  }
{% endstylesheet %}

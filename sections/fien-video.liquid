<section class="fvs">
  <div class="fvs__inner">

    {%- if section.settings.eyebrow != blank -%}
      <p class="fvs__eyebrow">{{- section.settings.eyebrow -}}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="fvs__heading">{{- section.settings.heading -}}</h2>
    {%- endif -%}

    <div class="fvs__video-wrap">
      {%- if section.settings.video_url != blank -%}
        {%- comment -%}
          Paste your YouTube embed URL  →  https://www.youtube.com/embed/VIDEO_ID
          or your Vimeo embed URL       →  https://player.vimeo.com/video/VIDEO_ID
          into the "Video embed URL" field in the theme editor (or directly here).
        {%- endcomment -%}
        <iframe
          class="fvs__iframe"
          src="{{ section.settings.video_url }}"
          title="{{ section.settings.heading | default: 'Video' | escape }}"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      {%- else -%}
        <div class="fvs__placeholder">
          <span class="fvs__placeholder-icon" aria-hidden="true">▶</span>
          <p class="fvs__placeholder-text">Add a YouTube or Vimeo embed URL in the theme editor</p>
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

{% stylesheet %}
  /* ── Video section ──────────────────────────────────────────────────────── */

  .fvs {
    background: #080808;
    background: var(--black);
    padding: 80px 60px;
  }

  .fvs__inner {
    max-width: 900px;
    margin: 0 auto;
  }

  .fvs__eyebrow {
    font-family: 'Montserrat', sans-serif;
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: #c9a84c;
    color: var(--gold);
    margin: 0 0 14px;
  }

  .fvs__heading {
    font-family: 'Bebas Neue', sans-serif;
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 52px);
    letter-spacing: 0.06em;
    color: #f0ece4;
    color: var(--white);
    margin: 0 0 36px;
    line-height: 1;
  }

  .fvs__video-wrap {
    position: relative;
    width: 100%;
    padding-top: 56.25%;
    background: #161616;
    border: 1px solid rgba(255, 255, 255, 0.07);
  }

  .fvs__iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .fvs__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .fvs__placeholder-icon {
    font-size: 48px;
    color: #c9a84c;
    color: var(--gold);
    opacity: 0.4;
  }

  .fvs__placeholder-text {
    font-family: 'Montserrat', sans-serif;
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(240, 236, 228, 0.3);
    color: var(--muted);
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .fvs {
      padding: 60px 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Video",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Behind the lens"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Vision"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video embed URL",
      "info": "YouTube: https://www.youtube.com/embed/VIDEO_ID — Vimeo: https://player.vimeo.com/video/VIDEO_ID"
    }
  ],
  "presets": [
    {
      "name": "Video"
    }
  ]
}
{% endschema %}

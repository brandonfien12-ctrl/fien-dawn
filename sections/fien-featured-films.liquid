<section class="ffc" id="fien-films">

  {%- comment -%} Section header {%- endcomment -%}
  <div class="ffc__header">
    <p class="ffc__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="ffc__heading">{{ section.settings.heading }}</h2>
    <p class="ffc__subtitle">{{ section.settings.subtitle }}</p>
  </div>

  {%- if section.blocks.size > 0 -%}

    {%- comment -%} Coverflow carousel {%- endcomment -%}
    <div
      class="ffc__carousel"
      id="ffcCarousel-{{ section.id }}"
      data-section="{{ section.id }}"
    >

      {%- comment -%} Arrow: previous {%- endcomment -%}
      <button
        class="ffc__arrow ffc__arrow--prev"
        aria-label="{{ 'sections.fien_featured_films.prev' | t }}"
        type="button"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M13 4L7 10L13 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      {%- comment -%} 3D stage — perspective set here {%- endcomment -%}
      <div class="ffc__stage">
        <ul
          class="ffc__track"
          role="list"
          aria-label="{{ 'sections.fien_featured_films.carousel_label' | t }}"
        >
          {%- for block in section.blocks -%}
            <li
              class="ffc-card"
              data-index="{{ forloop.index0 }}"
              aria-roledescription="slide"
              {{ block.shopify_attributes }}
            >

              {%- comment -%}
                Playable media — Shopify-hosted video only.

                video_tag renders Shopify's own <video> element, so the file is
                picked/uploaded through the theme editor's video picker and
                served from Shopify's CDN. No external embed is involved.

                preload: 'none' is deliberate: with up to 24 films in the
                carousel, preloading even metadata for every one costs a
                request each on first paint. The poster still renders, so the
                card looks identical until the visitor presses play.

                The poster comes from the block's own image if the merchant set
                one, otherwise from image_size, which uses the frame Shopify
                generates when the video is uploaded.
              {%- endcomment -%}
              <div class="ffc-card__media-wrap">
                {%- if block.settings.video != blank -%}
                  {%- if block.settings.poster_image != blank -%}
                    {%- assign film_poster = block.settings.poster_image | image_url: width: 1280 -%}
                    {{
                      block.settings.video
                      | video_tag:
                        controls: true,
                        playsinline: true,
                        preload: 'none',
                        poster: film_poster,
                        class: 'ffc-card__media ffc-card__media--video'
                    }}
                  {%- else -%}
                    {{
                      block.settings.video
                      | video_tag:
                        controls: true,
                        playsinline: true,
                        preload: 'none',
                        class: 'ffc-card__media ffc-card__media--video',
                        image_size: '1280x'
                    }}
                  {%- endif -%}
                {%- elsif block.settings.poster_image != blank -%}
                  {%- comment -%}
                    No film chosen yet — show the poster on its own so the
                    slide is never empty while the merchant is still setting up.
                  {%- endcomment -%}
                  {{
                    block.settings.poster_image
                    | image_url: width: 1280
                    | image_tag:
                      class: 'ffc-card__media ffc-card__media--image',
                      loading: 'lazy',
                      widths: '400, 600, 800, 1280'
                  }}
                {%- else -%}
                  <div class="ffc-card__media-placeholder" aria-hidden="true"></div>
                {%- endif -%}
              </div>

              {%- comment -%} Card body — simple title only {%- endcomment -%}
              {%- if block.settings.title != blank -%}
                <div class="ffc-card__body">
                  <h3 class="ffc-card__title">{{ block.settings.title }}</h3>
                </div>
              {%- endif -%}

            </li>
          {%- endfor -%}
        </ul>
      </div>

      {%- comment -%} Arrow: next {%- endcomment -%}
      <button
        class="ffc__arrow ffc__arrow--next"
        aria-label="{{ 'sections.fien_featured_films.next' | t }}"
        type="button"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M7 4L13 10L7 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

    </div>

    {%- comment -%} Dot indicators {%- endcomment -%}
    <div class="ffc__dots" role="tablist" aria-label="{{ 'sections.fien_featured_films.dots_label' | t }}">
      {%- for block in section.blocks -%}
        <button
          class="ffc__dot{% if forloop.first %} ffc__dot--active{% endif %}"
          role="tab"
          aria-label="{{ 'sections.fien_featured_films.go_to_slide' | t: index: forloop.index }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          data-dot="{{ forloop.index0 }}"
          type="button"
        ></button>
      {%- endfor -%}
    </div>

  {%- else -%}
    <p class="ffc__empty">{{ 'sections.fien_featured_films.empty' | t }}</p>
  {%- endif -%}

</section>

{% stylesheet %}
  /* ── Featured films section (coverflow carousel, forked from featured-prints) ── */

  .ffc {
    background: var(--deep);
    padding: 120px 0 120px;
    overflow-x: clip;
  }

  /* ── Section header ───────────────────────────────────────────────────── */

  .ffc__header {
    margin-bottom: 64px;
    max-width: 700px;
    padding: 0 60px;
  }

  .ffc__eyebrow {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 16px;
  }

  .ffc__heading {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 64px);
    letter-spacing: 0.06em;
    line-height: 1;
    color: var(--white);
    margin: 0 0 24px;
  }

  .ffc__subtitle {
    font-family: var(--font-serif);
    font-size: 18px;
    font-style: italic;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.8;
    margin: 0;
  }

  /* ── Carousel wrapper ─────────────────────────────────────────────────── */

  .ffc__carousel {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── 3D Stage ─────────────────────────────────────────────────────────── */

  /* Perspective is scaled with the cards (was 1200px for a 460px card). Left
     at 1200 while the cards grew 40%, the foreshortening on the angled side
     cards would get noticeably harsher rather than just larger. */
  .ffc__stage {
    perspective: 1680px;
    width: 100%;
    position: relative;
  }

  /* ── Track — cards are absolute inside here ───────────────────────────── */

  .ffc__track {
    position: relative;
    width: 100%;
    list-style: none;
    margin: 0;
    padding: 0;
    transform-style: preserve-3d;
  }

  /* ── Card base — positioned from center ──────────────────────────────── */

  .ffc-card {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    /* 644px = 460 x 1.4. The 78vw cap is unchanged: below ~826px viewport the
       card is already viewport-bound, so phones stay as they were — see the
       note on SLOTS_MOBILE in the script below. */
    width: min(644px, 78vw);
    background: var(--dark);
    border: 1px solid var(--border);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      opacity   0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      border-color 0.3s ease;
    will-change: transform, opacity;
    cursor: pointer;
  }

  .ffc-card[data-slot="0"]:hover {
    border-color: rgba(201, 168, 76, 0.3);
  }

  .ffc-card[data-slot="1"],
  .ffc-card[data-slot="-1"] {
    cursor: pointer;
  }

  /* ── Card media ───────────────────────────────────────────────────────── */

  .ffc-card__media-wrap {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--mid);
    position: relative;
  }

  .ffc-card__media {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }

  .ffc-card__media-placeholder {
    width: 100%;
    height: 100%;
    background: var(--mid);
  }

  /* ── Card body — title only ───────────────────────────────────────────── */

  .ffc-card__body {
    padding: 20px 24px;
    background: var(--dark);
  }

  .ffc-card__title {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 300;
    color: var(--white);
    margin: 0;
    line-height: 1.3;
  }

  /* ── Arrow buttons ────────────────────────────────────────────────────── */

  .ffc__arrow {
    position: relative;
    z-index: 20;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--gold);
    background: transparent;
    color: var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
    margin: 0 16px;
  }

  .ffc__arrow:hover {
    background: var(--gold);
    color: #080808;
  }

  /* ── Dot indicators ───────────────────────────────────────────────────── */

  .ffc__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 40px;
    padding: 0 60px;
  }

  .ffc__dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: var(--border);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: width 0.3s ease, background 0.3s ease;
  }

  .ffc__dot--active {
    width: 24px;
    background: var(--gold);
  }

  /* ── Empty state ──────────────────────────────────────────────────────── */

  .ffc__empty {
    font-family: var(--font-serif);
    font-size: 18px;
    font-style: italic;
    color: var(--muted);
    text-align: center;
    padding: 60px;
  }

  /* ── Mobile ───────────────────────────────────────────────────────────── */

  @media screen and (max-width: 749px) {
    .ffc {
      padding: 80px 0 64px;
    }

    .ffc__header {
      padding: 0 24px;
      margin-bottom: 48px;
    }

    .ffc__arrow {
      width: 40px;
      height: 40px;
      margin: 0 8px;
    }

    .ffc__dots {
      padding: 0 24px;
      margin-top: 28px;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var TRANSITION = '0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
    var AUTO_DELAY = 6000;

    // Desktop translations scaled 1.4x alongside the card width (340 -> 476,
    // 560 -> 784, and the same on tz). These have to move with the card: left
    // at their old values, a 40% wider card would overlap its neighbours
    // instead of fanning out behind them. Rotation, scale and opacity are
    // untouched, so the coverflow reads exactly as before, just larger.
    var SLOTS_DESKTOP = {
       0: { tx:   0, tz:    0, ry:   0, sc: 1.00, op: 1.0 },
       1: { tx: 476, tz: -224, ry: -45, sc: 0.85, op: 0.6 },
      '-1': { tx:-476, tz: -224, ry:  45, sc: 0.85, op: 0.6 },
       2: { tx: 784, tz: -392, ry: -70, sc: 0.70, op: 0.3 },
      '-2': { tx:-784, tz: -392, ry:  70, sc: 0.70, op: 0.3 }
    };
    // Deliberately unchanged. On phones the card is already capped at 78vw, so
    // it cannot grow 40% (that would be 109vw). Widening these offsets without
    // a wider card would just push the neighbouring films off-screen and lose
    // the coverflow peek that makes the carousel legible as one.
    var SLOTS_MOBILE = {
       0: { tx:   0, tz:    0, ry:   0, sc: 1.00, op: 1.0 },
       1: { tx: 210, tz:  -80, ry: -30, sc: 0.85, op: 0.6 },
      '-1': { tx:-210, tz:  -80, ry:  30, sc: 0.85, op: 0.6 },
       2: { tx: 380, tz: -160, ry: -60, sc: 0.70, op: 0.3 },
      '-2': { tx:-380, tz: -160, ry:  60, sc: 0.70, op: 0.3 }
    };

    function isMobile() {
      return window.innerWidth <= 749;
    }

    function slots() {
      return isMobile() ? SLOTS_MOBILE : SLOTS_DESKTOP;
    }

    function wrapIndex(i, total) {
      return ((i % total) + total) % total;
    }

    function slotOffset(cardIndex, activeIndex, total) {
      var raw = cardIndex - activeIndex;
      if (raw >  total / 2) raw -= total;
      if (raw < -total / 2) raw += total;
      return raw;
    }

    function init(carouselEl) {
      // The theme editor re-renders this section every time a film block is
      // added, removed or reordered, so init runs again on the fresh markup.
      // Bail if we already wired up this exact element.
      if (carouselEl.hasAttribute('data-ffc-ready')) return;
      carouselEl.setAttribute('data-ffc-ready', '');

      var cards     = Array.prototype.slice.call(carouselEl.querySelectorAll('.ffc-card'));
      var dots      = Array.prototype.slice.call(
        carouselEl.closest('.ffc').querySelectorAll('.ffc__dot')
      );
      var prevBtn   = carouselEl.querySelector('.ffc__arrow--prev');
      var nextBtn   = carouselEl.querySelector('.ffc__arrow--next');
      var stage     = carouselEl.querySelector('.ffc__stage');
      var track     = carouselEl.querySelector('.ffc__track');
      var total     = cards.length;
      if (total === 0) return;

      var activeIndex = 0;
      var autoTimer   = null;
      var paused      = false;
      // Set while a film is actually playing, so the 6s auto-advance does not
      // slide the carousel out from under someone who is watching.
      var videoPlaying = false;

      function updateHeight(retriesLeft) {
        var activeCard = cards[activeIndex];
        if (!activeCard) return;
        var h = activeCard.offsetHeight;
        if (h > 0) {
          track.style.height = h + 'px';
          stage.style.height = h + 'px';
          return;
        }
        // The cards are absolutely positioned, so the track only has a height
        // because we set one here. If we measure 0 — which happens when the
        // editor re-renders the section before the media has been laid out —
        // the whole carousel would collapse to nothing. Retry on the next few
        // frames rather than leaving it flattened.
        var remaining = typeof retriesLeft === 'number' ? retriesLeft : 10;
        if (remaining > 0) {
          requestAnimationFrame(function () { updateHeight(remaining - 1); });
        }
      }

      function render(skipTransition) {
        var s = slots();
        cards.forEach(function (card, i) {
          var offset = slotOffset(i, activeIndex, total);
          var clampedOffset = Math.max(-2, Math.min(2, offset));
          var config = s[String(clampedOffset)] || s[String(clampedOffset > 0 ? 2 : -2)];
          var hidden = Math.abs(offset) > 2;

          var transform = 'translateX(calc(-50% + ' + config.tx + 'px)) '
            + 'translateZ(' + config.tz + 'px) '
            + 'rotateY(' + config.ry + 'deg) '
            + 'scale(' + config.sc + ')';

          card.style.transition = skipTransition
            ? 'none'
            : 'transform ' + TRANSITION + ', opacity ' + TRANSITION + ', border-color 0.3s ease';
          card.style.transform      = transform;
          card.style.opacity        = hidden ? '0' : String(config.op);
          card.style.zIndex         = hidden ? '0' : String(10 - Math.abs(offset));
          card.style.pointerEvents  = hidden ? 'none' : (Math.abs(offset) <= 2 ? 'auto' : 'none');
          card.setAttribute('data-slot', String(offset));
          card.setAttribute('aria-hidden', hidden ? 'true' : 'false');

          // Only the centre film may play. Anything rotated away, faded out or
          // fully hidden gets paused, so we never have several videos decoding
          // at once off-screen.
          if (offset !== 0) {
            var offVideo = card.querySelector('video');
            if (offVideo && !offVideo.paused) offVideo.pause();
          }
        });

        dots.forEach(function (dot, i) {
          var active = (i === activeIndex);
          dot.classList.toggle('ffc__dot--active', active);
          dot.setAttribute('aria-selected', active ? 'true' : 'false');
        });

        updateHeight();
      }

      function goTo(index) {
        activeIndex = wrapIndex(index, total);
        render(false);
        resetTimer();
      }

      function prev() { goTo(activeIndex - 1); }
      function next() { goTo(activeIndex + 1); }

      function startTimer() {
        if (autoTimer) clearInterval(autoTimer);
        autoTimer = setInterval(function () {
          if (!paused && !videoPlaying) next();
        }, AUTO_DELAY);
      }

      function resetTimer() {
        startTimer();
      }

      function pause()  { paused = true; }
      function resume() { paused = false; }

      if (prevBtn) prevBtn.addEventListener('click', prev);
      if (nextBtn) nextBtn.addEventListener('click', next);

      dots.forEach(function (dot, i) {
        dot.addEventListener('click', function () { goTo(i); });
      });

      cards.forEach(function (card) {
        card.addEventListener('click', function (e) {
          var offset = parseInt(card.getAttribute('data-slot'), 10);
          if (offset === 1)  { e.preventDefault(); next(); }
          if (offset === -1) { e.preventDefault(); prev(); }
          if (Math.abs(offset) >= 2) e.preventDefault();
        });
      });

      // Film playback bookkeeping. Pressing play on the centre film holds the
      // carousel still; pausing, finishing or navigating away releases it.
      // Playing one film also stops any other that is somehow still running.
      cards.forEach(function (card) {
        var video = card.querySelector('video');
        if (!video) return;

        video.addEventListener('play', function () {
          videoPlaying = true;
          cards.forEach(function (other) {
            if (other === card) return;
            var otherVideo = other.querySelector('video');
            if (otherVideo && !otherVideo.paused) otherVideo.pause();
          });
          // The poster is replaced by the first frame here, which can change
          // the card's height on unusual aspect ratios.
          updateHeight();
        });

        video.addEventListener('pause', function () { videoPlaying = false; });
        video.addEventListener('ended', function () { videoPlaying = false; });
      });

      carouselEl.addEventListener('mouseenter', pause);
      carouselEl.addEventListener('mouseleave', resume);

      var touchStartX = null;
      stage.addEventListener('touchstart', function (e) {
        touchStartX = e.touches[0].clientX;
        pause();
      }, { passive: true });
      stage.addEventListener('touchend', function (e) {
        if (touchStartX === null) return;
        var delta = e.changedTouches[0].clientX - touchStartX;
        if (Math.abs(delta) > 40) {
          if (delta < 0) next(); else prev();
        }
        touchStartX = null;
        resume();
      }, { passive: true });

      carouselEl.setAttribute('tabindex', '0');
      carouselEl.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowLeft')  { e.preventDefault(); prev(); }
        if (e.key === 'ArrowRight') { e.preventDefault(); next(); }
      });

      function onResize() {
        render(true);
        requestAnimationFrame(function () {
          render(false);
        });
      }
      window.addEventListener('resize', onResize);

      render(true);
      startTimer();

      // Re-measure once the active card's media actually arrives, otherwise the
      // track can keep the height of a not-yet-loaded image.
      var activeMedia = cards[activeIndex] && cards[activeIndex].querySelector('img, video');
      if (activeMedia) {
        if (activeMedia.tagName === 'IMG' && !activeMedia.complete) {
          activeMedia.addEventListener('load', function () { updateHeight(); }, { once: true });
        } else if (activeMedia.tagName === 'VIDEO') {
          activeMedia.addEventListener('loadedmetadata', function () { updateHeight(); }, { once: true });
        }
      }

      // Handed to the theme-editor hooks below so they can drive this instance
      // without re-running init or leaking its timer and resize listener.
      carouselEl.ffc = {
        goTo: goTo,
        pause: pause,
        resume: resume,
        refresh: function () { render(true); updateHeight(); },
        destroy: function () {
          if (autoTimer) clearInterval(autoTimer);
          autoTimer = null;
          window.removeEventListener('resize', onResize);
          carouselEl.removeAttribute('data-ffc-ready');
        }
      };
    }

    function initAll(root) {
      var scope = root && root.querySelectorAll ? root : document;
      var found = scope.querySelectorAll('.ffc__carousel');
      Array.prototype.forEach.call(found, function (el) { init(el); });
      // shopify:section:load hands us the section wrapper itself, which may be
      // the carousel's ancestor but is not guaranteed to contain it via
      // querySelectorAll if the carousel *is* the target.
      if (scope !== document && scope.classList && scope.classList.contains('ffc__carousel')) {
        init(scope);
      }
    }

    initAll(document);

    // ── Theme editor lifecycle ──────────────────────────────────────────────
    // Adding, removing or reordering a film re-renders the section through the
    // Section Rendering API. Without these hooks the new markup never gets
    // initialised: the cards stay absolutely positioned with no transforms and
    // the track has no height, so the carousel looks like it vanished and the
    // films pile up on top of each other.

    document.addEventListener('shopify:section:load', function (event) {
      initAll(event.target);
    });

    document.addEventListener('shopify:section:unload', function (event) {
      var gone = event.target.querySelectorAll ? event.target.querySelectorAll('.ffc__carousel') : [];
      Array.prototype.forEach.call(gone, function (el) {
        if (el.ffc) el.ffc.destroy();
      });
    });

    // Selecting a film in the sidebar should bring that film to the front and
    // hold it there while it is being edited.
    document.addEventListener('shopify:block:select', function (event) {
      var card = event.target.closest ? event.target.closest('.ffc-card') : null;
      if (!card) return;
      var carouselEl = card.closest('.ffc__carousel');
      if (!carouselEl) return;
      init(carouselEl);
      if (!carouselEl.ffc) return;
      var index = parseInt(card.getAttribute('data-index'), 10);
      if (!isNaN(index)) carouselEl.ffc.goTo(index);
      carouselEl.ffc.pause();
    });

    document.addEventListener('shopify:block:deselect', function (event) {
      var card = event.target.closest ? event.target.closest('.ffc-card') : null;
      if (!card) return;
      var carouselEl = card.closest('.ffc__carousel');
      if (carouselEl && carouselEl.ffc) carouselEl.ffc.resume();
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Featured films",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Selected work"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Films"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Short films from the field — expeditions, process, and the stories behind the prints."
    }
  ],
  "blocks": [
    {
      "type": "film",
      "name": "Film",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Film",
          "info": "Select or upload a video. It is hosted by Shopify — no YouTube or Vimeo link needed."
        },
        {
          "type": "image_picker",
          "id": "poster_image",
          "label": "Poster image",
          "info": "Optional. Shown before the film plays. Defaults to a frame from the video."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Featured films",
      "blocks": [
        { "type": "film" },
        { "type": "film" },
        { "type": "film" }
      ]
    }
  ]
}
{% endschema %}

<section class="ffc" id="fien-films">

  {%- comment -%} Section header {%- endcomment -%}
  <div class="ffc__header">
    <p class="ffc__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="ffc__heading">{{ section.settings.heading }}</h2>
    <p class="ffc__subtitle">{{ section.settings.subtitle }}</p>
  </div>

  {%- if section.blocks.size > 0 -%}

    {%- comment -%} Coverflow carousel {%- endcomment -%}
    <div
      class="ffc__carousel"
      id="ffcCarousel-{{ section.id }}"
      data-section="{{ section.id }}"
    >

      {%- comment -%} Arrow: previous {%- endcomment -%}
      <button
        class="ffc__arrow ffc__arrow--prev"
        aria-label="{{ 'sections.fien_featured_films.prev' | t }}"
        type="button"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M13 4L7 10L13 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      {%- comment -%} 3D stage — perspective set here {%- endcomment -%}
      <div class="ffc__stage">
        <ul
          class="ffc__track"
          role="list"
          aria-label="{{ 'sections.fien_featured_films.carousel_label' | t }}"
        >
          {%- for block in section.blocks -%}
            <li
              class="ffc-card"
              data-index="{{ forloop.index0 }}"
              aria-roledescription="slide"
              {{ block.shopify_attributes }}
            >

              {%- comment -%} Playable media {%- endcomment -%}
              <div class="ffc-card__media-wrap">
                {%- if block.settings.video != blank -%}
                  {{
                    block.settings.video
                    | video_tag:
                      controls: true,
                      playsinline: true,
                      preload: 'metadata',
                      class: 'ffc-card__media ffc-card__media--video',
                      image_size: '800x'
                  }}
                {%- elsif block.settings.video_url != blank -%}
                  {%- if block.settings.video_url.type == 'youtube' -%}
                    <iframe
                      class="ffc-card__media ffc-card__media--embed"
                      src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}"
                      title="{{ block.settings.title | escape }}"
                      loading="lazy"
                      allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                    ></iframe>
                  {%- elsif block.settings.video_url.type == 'vimeo' -%}
                    <iframe
                      class="ffc-card__media ffc-card__media--embed"
                      src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}"
                      title="{{ block.settings.title | escape }}"
                      loading="lazy"
                      allow="autoplay; fullscreen; picture-in-picture"
                      allowfullscreen
                    ></iframe>
                  {%- endif -%}
                {%- elsif block.settings.cover_image != blank -%}
                  {{
                    block.settings.cover_image
                    | image_url: width: 800
                    | image_tag:
                      class: 'ffc-card__media ffc-card__media--image',
                      loading: 'lazy',
                      widths: '400, 600, 800'
                  }}
                {%- else -%}
                  <div class="ffc-card__media-placeholder" aria-hidden="true"></div>
                {%- endif -%}
              </div>

              {%- comment -%} Card body — simple title only {%- endcomment -%}
              {%- if block.settings.title != blank -%}
                <div class="ffc-card__body">
                  <h3 class="ffc-card__title">{{ block.settings.title }}</h3>
                </div>
              {%- endif -%}

            </li>
          {%- endfor -%}
        </ul>
      </div>

      {%- comment -%} Arrow: next {%- endcomment -%}
      <button
        class="ffc__arrow ffc__arrow--next"
        aria-label="{{ 'sections.fien_featured_films.next' | t }}"
        type="button"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M7 4L13 10L7 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

    </div>

    {%- comment -%} Dot indicators {%- endcomment -%}
    <div class="ffc__dots" role="tablist" aria-label="{{ 'sections.fien_featured_films.dots_label' | t }}">
      {%- for block in section.blocks -%}
        <button
          class="ffc__dot{% if forloop.first %} ffc__dot--active{% endif %}"
          role="tab"
          aria-label="{{ 'sections.fien_featured_films.go_to_slide' | t: index: forloop.index }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          data-dot="{{ forloop.index0 }}"
          type="button"
        ></button>
      {%- endfor -%}
    </div>

  {%- else -%}
    <p class="ffc__empty">{{ 'sections.fien_featured_films.empty' | t }}</p>
  {%- endif -%}

</section>

{% stylesheet %}
  /* ── Featured films section (coverflow carousel, forked from featured-prints) ── */

  .ffc {
    background: var(--deep);
    padding: 120px 0 120px;
    overflow-x: clip;
  }

  /* ── Section header ───────────────────────────────────────────────────── */

  .ffc__header {
    margin-bottom: 64px;
    max-width: 700px;
    padding: 0 60px;
  }

  .ffc__eyebrow {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 16px;
  }

  .ffc__heading {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 64px);
    letter-spacing: 0.06em;
    line-height: 1;
    color: var(--white);
    margin: 0 0 24px;
  }

  .ffc__subtitle {
    font-family: var(--font-serif);
    font-size: 18px;
    font-style: italic;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.8;
    margin: 0;
  }

  /* ── Carousel wrapper ─────────────────────────────────────────────────── */

  .ffc__carousel {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── 3D Stage ─────────────────────────────────────────────────────────── */

  .ffc__stage {
    perspective: 1200px;
    width: 100%;
    position: relative;
  }

  /* ── Track — cards are absolute inside here ───────────────────────────── */

  .ffc__track {
    position: relative;
    width: 100%;
    list-style: none;
    margin: 0;
    padding: 0;
    transform-style: preserve-3d;
  }

  /* ── Card base — positioned from center ──────────────────────────────── */

  .ffc-card {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(460px, 78vw);
    background: var(--dark);
    border: 1px solid var(--border);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      opacity   0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      border-color 0.3s ease;
    will-change: transform, opacity;
    cursor: pointer;
  }

  .ffc-card[data-slot="0"]:hover {
    border-color: rgba(201, 168, 76, 0.3);
  }

  .ffc-card[data-slot="1"],
  .ffc-card[data-slot="-1"] {
    cursor: pointer;
  }

  /* ── Card media ───────────────────────────────────────────────────────── */

  .ffc-card__media-wrap {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--mid);
    position: relative;
  }

  .ffc-card__media {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }

  .ffc-card__media--embed {
    aspect-ratio: 16 / 9;
  }

  .ffc-card__media-placeholder {
    width: 100%;
    height: 100%;
    background: var(--mid);
  }

  /* ── Card body — title only ───────────────────────────────────────────── */

  .ffc-card__body {
    padding: 20px 24px;
    background: var(--dark);
  }

  .ffc-card__title {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 300;
    color: var(--white);
    margin: 0;
    line-height: 1.3;
  }

  /* ── Arrow buttons ────────────────────────────────────────────────────── */

  .ffc__arrow {
    position: relative;
    z-index: 20;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--gold);
    background: transparent;
    color: var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
    margin: 0 16px;
  }

  .ffc__arrow:hover {
    background: var(--gold);
    color: #080808;
  }

  /* ── Dot indicators ───────────────────────────────────────────────────── */

  .ffc__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 40px;
    padding: 0 60px;
  }

  .ffc__dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: var(--border);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: width 0.3s ease, background 0.3s ease;
  }

  .ffc__dot--active {
    width: 24px;
    background: var(--gold);
  }

  /* ── Empty state ──────────────────────────────────────────────────────── */

  .ffc__empty {
    font-family: var(--font-serif);
    font-size: 18px;
    font-style: italic;
    color: var(--muted);
    text-align: center;
    padding: 60px;
  }

  /* ── Mobile ───────────────────────────────────────────────────────────── */

  @media screen and (max-width: 749px) {
    .ffc {
      padding: 80px 0 64px;
    }

    .ffc__header {
      padding: 0 24px;
      margin-bottom: 48px;
    }

    .ffc__arrow {
      width: 40px;
      height: 40px;
      margin: 0 8px;
    }

    .ffc__dots {
      padding: 0 24px;
      margin-top: 28px;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var TRANSITION = '0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
    var AUTO_DELAY = 6000;

    var SLOTS_DESKTOP = {
       0: { tx:   0, tz:    0, ry:   0, sc: 1.00, op: 1.0 },
       1: { tx: 340, tz: -160, ry: -45, sc: 0.85, op: 0.6 },
      '-1': { tx:-340, tz: -160, ry:  45, sc: 0.85, op: 0.6 },
       2: { tx: 560, tz: -280, ry: -70, sc: 0.70, op: 0.3 },
      '-2': { tx:-560, tz: -280, ry:  70, sc: 0.70, op: 0.3 }
    };
    var SLOTS_MOBILE = {
       0: { tx:   0, tz:    0, ry:   0, sc: 1.00, op: 1.0 },
       1: { tx: 210, tz:  -80, ry: -30, sc: 0.85, op: 0.6 },
      '-1': { tx:-210, tz:  -80, ry:  30, sc: 0.85, op: 0.6 },
       2: { tx: 380, tz: -160, ry: -60, sc: 0.70, op: 0.3 },
      '-2': { tx:-380, tz: -160, ry:  60, sc: 0.70, op: 0.3 }
    };

    function isMobile() {
      return window.innerWidth <= 749;
    }

    function slots() {
      return isMobile() ? SLOTS_MOBILE : SLOTS_DESKTOP;
    }

    function wrapIndex(i, total) {
      return ((i % total) + total) % total;
    }

    function slotOffset(cardIndex, activeIndex, total) {
      var raw = cardIndex - activeIndex;
      if (raw >  total / 2) raw -= total;
      if (raw < -total / 2) raw += total;
      return raw;
    }

    function init(carouselEl) {
      var cards     = Array.prototype.slice.call(carouselEl.querySelectorAll('.ffc-card'));
      var dots      = Array.prototype.slice.call(
        carouselEl.closest('.ffc').querySelectorAll('.ffc__dot')
      );
      var prevBtn   = carouselEl.querySelector('.ffc__arrow--prev');
      var nextBtn   = carouselEl.querySelector('.ffc__arrow--next');
      var stage     = carouselEl.querySelector('.ffc__stage');
      var track     = carouselEl.querySelector('.ffc__track');
      var total     = cards.length;
      if (total === 0) return;

      var activeIndex = 0;
      var autoTimer   = null;
      var paused      = false;

      function updateHeight() {
        var activeCard = cards[activeIndex];
        if (!activeCard) return;
        var h = activeCard.offsetHeight;
        if (h > 0) {
          track.style.height = h + 'px';
          stage.style.height = h + 'px';
        }
      }

      function render(skipTransition) {
        var s = slots();
        cards.forEach(function (card, i) {
          var offset = slotOffset(i, activeIndex, total);
          var clampedOffset = Math.max(-2, Math.min(2, offset));
          var config = s[String(clampedOffset)] || s[String(clampedOffset > 0 ? 2 : -2)];
          var hidden = Math.abs(offset) > 2;

          var transform = 'translateX(calc(-50% + ' + config.tx + 'px)) '
            + 'translateZ(' + config.tz + 'px) '
            + 'rotateY(' + config.ry + 'deg) '
            + 'scale(' + config.sc + ')';

          card.style.transition = skipTransition
            ? 'none'
            : 'transform ' + TRANSITION + ', opacity ' + TRANSITION + ', border-color 0.3s ease';
          card.style.transform      = transform;
          card.style.opacity        = hidden ? '0' : String(config.op);
          card.style.zIndex         = hidden ? '0' : String(10 - Math.abs(offset));
          card.style.pointerEvents  = hidden ? 'none' : (Math.abs(offset) <= 2 ? 'auto' : 'none');
          card.setAttribute('data-slot', String(offset));
          card.setAttribute('aria-hidden', hidden ? 'true' : 'false');
        });

        dots.forEach(function (dot, i) {
          var active = (i === activeIndex);
          dot.classList.toggle('ffc__dot--active', active);
          dot.setAttribute('aria-selected', active ? 'true' : 'false');
        });

        updateHeight();
      }

      function goTo(index) {
        activeIndex = wrapIndex(index, total);
        render(false);
        resetTimer();
      }

      function prev() { goTo(activeIndex - 1); }
      function next() { goTo(activeIndex + 1); }

      function startTimer() {
        if (autoTimer) clearInterval(autoTimer);
        autoTimer = setInterval(function () {
          if (!paused) next();
        }, AUTO_DELAY);
      }

      function resetTimer() {
        startTimer();
      }

      function pause()  { paused = true; }
      function resume() { paused = false; }

      if (prevBtn) prevBtn.addEventListener('click', prev);
      if (nextBtn) nextBtn.addEventListener('click', next);

      dots.forEach(function (dot, i) {
        dot.addEventListener('click', function () { goTo(i); });
      });

      cards.forEach(function (card) {
        card.addEventListener('click', function (e) {
          var offset = parseInt(card.getAttribute('data-slot'), 10);
          if (offset === 1)  { e.preventDefault(); next(); }
          if (offset === -1) { e.preventDefault(); prev(); }
          if (Math.abs(offset) >= 2) e.preventDefault();
        });
      });

      carouselEl.addEventListener('mouseenter', pause);
      carouselEl.addEventListener('mouseleave', resume);

      var touchStartX = null;
      stage.addEventListener('touchstart', function (e) {
        touchStartX = e.touches[0].clientX;
        pause();
      }, { passive: true });
      stage.addEventListener('touchend', function (e) {
        if (touchStartX === null) return;
        var delta = e.changedTouches[0].clientX - touchStartX;
        if (Math.abs(delta) > 40) {
          if (delta < 0) next(); else prev();
        }
        touchStartX = null;
        resume();
      }, { passive: true });

      carouselEl.setAttribute('tabindex', '0');
      carouselEl.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowLeft')  { e.preventDefault(); prev(); }
        if (e.key === 'ArrowRight') { e.preventDefault(); next(); }
      });

      window.addEventListener('resize', function () {
        render(true);
        requestAnimationFrame(function () {
          render(false);
        });
      });

      render(true);
      startTimer();

      var activeMedia = cards[activeIndex] && cards[activeIndex].querySelector('img, video');
      if (activeMedia && activeMedia.tagName === 'IMG' && !activeMedia.complete) {
        activeMedia.addEventListener('load', function () { updateHeight(); }, { once: true });
      }
    }

    var carousels = document.querySelectorAll('.ffc__carousel');
    carousels.forEach(function (el) { init(el); });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Featured films",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Selected work"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Films"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Short films from the field — expeditions, process, and the stories behind the prints."
    }
  ],
  "blocks": [
    {
      "type": "film",
      "name": "Film",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video (uploaded)",
          "info": "Uploaded video takes priority over the URL below if both are set."
        },
        {
          "type": "video_url",
          "id": "video_url",
          "accept": ["youtube", "vimeo"],
          "label": "Video URL",
          "placeholder": "https://www.youtube.com/watch?v=...",
          "info": "Used if no video is uploaded above."
        },
        {
          "type": "image_picker",
          "id": "cover_image",
          "label": "Cover image (fallback)",
          "info": "Shown only if no video or video URL is set."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Featured films",
      "blocks": [
        { "type": "film" },
        { "type": "film" },
        { "type": "film" }
      ]
    }
  ]
}
{% endschema %}

<product-info
  id="MainProduct-{{ section.id }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
>

  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign product_form_id = 'product-form-' | append: section.id -%}

  <section class="fpp">
    <div class="fpp__content">

      {%- comment -%} ── Gallery ── {%- endcomment -%}
      {%- assign fpp_main_img_id = 'fppMainImage-' | append: section.id -%}
      <div class="fpp__gallery" id="fppGallery-{{ section.id }}">

        <div class="fpp__main-wrap">
          {%- if product.featured_image != blank -%}
            {{
              product.featured_image
              | image_url: width: 1400
              | image_tag:
                class: 'fpp__main-img',
                id: fpp_main_img_id,
                loading: 'eager',
                widths: '700, 1000, 1400',
                alt: product.featured_image.alt | default: product.title | escape
            }}
          {%- else -%}
            <div class="fpp__img-placeholder"></div>
          {%- endif -%}
        </div>

        {%- comment -%} Thumbnail strip {%- endcomment -%}
        {%- if product.images.size > 1 -%}
          <div class="fpp__thumbs" role="list" aria-label="{{ 'sections.fien_product.gallery_label' | t }}">
            {%- for image in product.images limit: 6 -%}
              <button
                class="fpp__thumb{%- if forloop.first %} fpp__thumb--active{%- endif -%}"
                data-src="{{ image | image_url: width: 1400 }}"
                data-srcset="{{ image | image_url: width: 700 }} 700w, {{ image | image_url: width: 1000 }} 1000w, {{ image | image_url: width: 1400 }} 1400w"
                data-alt="{{ image.alt | default: product.title | escape }}"
                aria-label="{{ 'sections.fien_product.view_image' | t: index: forloop.index }}"
                type="button"
              >
                {{
                  image
                  | image_url: width: 220
                  | image_tag:
                    class: 'fpp__thumb-img',
                    loading: 'lazy',
                    alt: image.alt | default: product.title | escape
                }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

      </div>

      {%- comment -%} ── Untold story (below thumbnails) ── {%- endcomment -%}
      {%- if product.metafields.custom.untold_story != blank -%}
        <div class="fpp__untold">
          <p class="fpp__untold-label">{{- 'sections.fien_product.untold_story_heading' | t -}}</p>
          <p class="fpp__untold-text">{{ product.metafields.custom.untold_story }}</p>
        </div>
      {%- endif -%}

      {%- comment -%} ── Product details ── {%- endcomment -%}
      <div class="fpp__details">

        <p class="fpp__eyebrow">{{- 'sections.fien_product.edition_eyebrow' | t -}}</p>
        <h1 class="fpp__title">{{- product.title | escape -}}</h1>

        {%- comment -%} Price — product-info.js replaces this element's HTML on variant change {%- endcomment -%}
        <div id="price-{{ section.id }}" role="status" class="fpp__price-wrap">
          {%- render 'price', product: product, use_variant: true, show_badges: false, price_class: 'price--large' -%}
        </div>

        {%- comment -%} Variant picker {%- endcomment -%}
        <div class="fpp__variants">
          {%- for block in section.blocks -%}
            {%- if block.type == 'variant_picker' -%}
              {%- render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id -%}
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- comment -%} Buy button {%- endcomment -%}
        <div class="fpp__buy">
          {%- for block in section.blocks -%}
            {%- if block.type == 'buy_buttons' -%}
              {%- render 'buy-buttons',
                block: block,
                product: product,
                product_form_id: product_form_id,
                section_id: section.id,
                show_pickup_availability: false
              -%}
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- comment -%} Accordions {%- endcomment -%}
        <div class="fpp__accordions">

          <details class="fpp__accordion">
            <summary class="fpp__accordion-summary">
              <span>{{- 'sections.fien_product.details_heading' | t -}}</span>
              <span class="fpp__accordion-icon" aria-hidden="true">+</span>
            </summary>
            <div class="fpp__accordion-body">
              {%- if product.description != blank -%}
                {{ product.description }}
              {%- else -%}
                <p>{{- 'sections.fien_product.details_placeholder' | t -}}</p>
              {%- endif -%}
            </div>
          </details>

          <details class="fpp__accordion">
            <summary class="fpp__accordion-summary">
              <span>{{- 'sections.fien_product.shipping_heading' | t -}}</span>
              <span class="fpp__accordion-icon" aria-hidden="true">+</span>
            </summary>
            <div class="fpp__accordion-body">
              <p>{{- 'sections.fien_product.shipping_content' | t -}}</p>
            </div>
          </details>

          <details class="fpp__accordion">
            <summary class="fpp__accordion-summary">
              <span>{{- 'sections.fien_product.certificate_heading' | t -}}</span>
              <span class="fpp__accordion-icon" aria-hidden="true">+</span>
            </summary>
            <div class="fpp__accordion-body">
              <p>{{- 'sections.fien_product.certificate_content' | t -}}</p>
            </div>
          </details>

        </div>

      </div>
    </div>

    {%- comment -%} ── You may also like ── {%- endcomment -%}
    {%- assign related_collection = product.collections.first -%}
    {%- if related_collection != blank and related_collection.products_count > 1 -%}
      <div class="fpp__related">
        <div class="fpp__related-header">
          <p class="fpp__related-eyebrow">{{- 'sections.fien_product.related_eyebrow' | t -}}</p>
          <h2 class="fpp__related-heading">{{- 'sections.fien_product.related_heading' | t -}}</h2>
        </div>
        <ul class="fpp__related-grid" role="list">
          {%- assign related_count = 0 -%}
          {%- for related in related_collection.products limit: 8 -%}
            {%- if related.id != product.id -%}
              {%- if related_count < 4 -%}
                <li class="fpp-rel-card">

                  <a href="{{ related.url }}" class="fpp-rel-card__img-link" aria-label="{{ related.title | escape }}">
                    <div class="fpp-rel-card__img-wrap">
                      {%- if related.featured_image != blank -%}
                        {{
                          related.featured_image
                          | image_url: width: 800
                          | image_tag:
                            class: 'fpp-rel-card__img',
                            loading: 'lazy',
                            widths: '400, 600, 800',
                            alt: related.featured_image.alt | default: related.title | escape
                        }}
                      {%- else -%}
                        <div class="fpp-rel-card__img-placeholder" aria-hidden="true"></div>
                      {%- endif -%}
                    </div>
                  </a>

                  <div class="fpp-rel-card__body">
                    <h3 class="fpp-rel-card__title">{{ related.title }}</h3>
                    <p class="fpp-rel-card__edition">{{- 'sections.fien_featured_prints.edition_label' | t -}}</p>

                    {%- if related.options_with_values.size > 0 -%}
                      <div class="fpp-rel-card__formats">
                        {%- for value in related.options_with_values[0].values -%}
                          <span class="fpp-rel-card__tag">{{ value }}</span>
                        {%- endfor -%}
                      </div>
                    {%- endif -%}

                    <div class="fpp-rel-card__price-row">
                      <div class="fpp-rel-card__price">
                        <span class="fpp-rel-card__from">{{- 'sections.fien_featured_prints.from' | t -}}</span>
                        {{ related.price_min | money_without_trailing_zeros }}
                      </div>
                    </div>

                    <a href="{{ related.url }}" class="fpp-rel-card__btn">{{- 'sections.fien_featured_prints.select_options' | t -}}</a>
                  </div>

                </li>
                {%- assign related_count = related_count | plus: 1 -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

  </section>

</product-info>

{% stylesheet %}
  /* ── Product page wrapper ─────────────────────────────────────────────── */

  .fpp {
    background: var(--black);
    padding: 80px 60px 120px;
  }

  /* ── Single-column centered content ──────────────────────────────────── */

  .fpp__content {
    max-width: 900px;
    margin: 0 auto;
  }

  /* ── Gallery ──────────────────────────────────────────────────────────── */

  .fpp__gallery {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 0;
  }

  .fpp__main-wrap {
    width: 100%;
    background: var(--dark);
    border: 1px solid var(--border);
    line-height: 0;
  }

  .fpp__main-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .fpp__img-placeholder {
    width: 100%;
    aspect-ratio: 4 / 5;
    background: var(--mid);
  }

  /* ── Thumbnails ───────────────────────────────────────────────────────── */

  .fpp__thumbs {
    display: flex;
    gap: 8px;
    flex-wrap: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .fpp__thumbs::-webkit-scrollbar {
    display: none;
  }

  .fpp__thumb {
    flex: 0 0 auto;
    width: 72px;
    height: 72px;
    overflow: hidden;
    background: none;
    border: 1px solid var(--border);
    padding: 0;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .fpp__thumb:hover {
    border-color: rgba(201, 168, 76, 0.4);
  }

  .fpp__thumb--active {
    border-color: var(--gold);
  }

  .fpp__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Untold story ─────────────────────────────────────────────────────── */

  .fpp__untold {
    margin-top: 48px;
    padding-top: 48px;
    border-top: 1px solid var(--border);
  }

  .fpp__untold-label {
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 16px;
  }

  .fpp__untold-text {
    font-family: var(--font-serif);
    font-size: 17px;
    font-style: italic;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.85;
    margin: 0;
  }

  /* ── Product details ──────────────────────────────────────────────────── */

  .fpp__details {
    margin-top: 52px;
    padding-top: 52px;
    border-top: 1px solid var(--border);
  }

  .fpp__eyebrow {
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 16px;
  }

  .fpp__title {
    font-family: var(--font-serif);
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 300;
    color: var(--white);
    line-height: 1.15;
    margin: 0 0 28px;
  }

  /* ── Price override ───────────────────────────────────────────────────── */

  .fpp__price-wrap {
    margin-bottom: 36px;
  }

  .fpp__price-wrap .price {
    border: none;
    padding: 0;
    margin: 0;
    background: transparent;
  }

  .fpp__price-wrap .price--large .price-item {
    font-family: var(--font-display);
    font-size: 48px;
    letter-spacing: 0.04em;
    color: var(--gold);
    line-height: 1;
  }

  .fpp__price-wrap .price__container {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .fpp__price-wrap .price__regular {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .fpp__price-wrap .price-item {
    color: var(--gold);
  }

  .fpp__price-wrap .badge {
    display: none;
  }

  /* ── Variant picker override ──────────────────────────────────────────── */

  .fpp__variants {
    margin-bottom: 28px;
  }

  .fpp__variants .product-form__input {
    border: none;
    padding: 0;
    margin: 0 0 20px;
  }

  .fpp__variants .form__label {
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--muted);
    display: block;
    margin-bottom: 12px;
  }

  .fpp__variants .product-form__input--pill {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: flex-start;
  }

  .fpp__variants .product-form__input--pill legend.form__label {
    width: 100%;
    flex-shrink: 0;
  }

  .fpp__variants .product-form__input--pill input[type="radio"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .fpp__variants .product-form__input--pill label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 16px;
    border: 1px solid var(--border);
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
    background: transparent;
    min-width: 48px;
    text-align: center;
    border-radius: 0;
  }

  .fpp__variants .product-form__input--pill label:hover {
    border-color: rgba(201, 168, 76, 0.4);
    color: var(--white);
  }

  .fpp__variants .product-form__input--pill input[type="radio"]:checked + label {
    border-color: var(--gold);
    color: var(--gold);
  }

  .fpp__variants .product-form__input--pill input[type="radio"]:disabled + label {
    opacity: 0.3;
    cursor: not-allowed;
    text-decoration: line-through;
  }

  .fpp__variants .product-form__input--dropdown .form__label {
    font-family: var(--font-sans);
    font-size: 9px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .fpp__variants .select__select {
    background: var(--dark);
    color: var(--white);
    border: 1px solid var(--border);
    border-radius: 0;
    font-family: var(--font-sans);
    font-size: 11px;
  }

  /* ── Buy button override ──────────────────────────────────────────────── */

  .fpp__buy {
    margin-bottom: 36px;
  }

  .fpp__buy .product-form__submit.button--primary,
  .fpp__buy .product-form__submit.button--secondary {
    background: var(--gold);
    color: #080808;
    border: 1px solid var(--gold);
    border-radius: 0;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    padding: 18px;
    box-shadow: none;
    transition: background 0.3s ease, border-color 0.3s ease;
    width: 100%;
  }

  .fpp__buy .product-form__submit.button--primary:hover,
  .fpp__buy .product-form__submit.button--secondary:hover {
    background: var(--gold-light);
    border-color: var(--gold-light);
  }

  .fpp__buy .product-form__submit[disabled] {
    background: var(--mid);
    border-color: var(--border);
    color: var(--muted);
    opacity: 1;
    cursor: not-allowed;
  }

  .fpp__buy .product-form__error-message-wrapper {
    margin-bottom: 12px;
    color: var(--white);
    font-family: var(--font-sans);
    font-size: 12px;
  }

  /* ── Accordions ───────────────────────────────────────────────────────── */

  .fpp__accordions {
    border-top: 1px solid var(--border);
  }

  .fpp__accordion {
    border-bottom: 1px solid var(--border);
  }

  .fpp__accordion-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--white);
    transition: color 0.2s ease;
    user-select: none;
  }

  .fpp__accordion-summary::-webkit-details-marker {
    display: none;
  }

  .fpp__accordion-summary:hover {
    color: var(--gold);
  }

  .fpp__accordion-icon {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 300;
    color: var(--gold);
    line-height: 1;
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  .fpp__accordion[open] .fpp__accordion-icon {
    transform: rotate(45deg);
  }

  .fpp__accordion-body {
    padding: 0 0 20px;
    font-family: var(--font-serif);
    font-size: 16px;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.8;
  }

  .fpp__accordion-body p {
    margin: 0 0 12px;
  }

  .fpp__accordion-body p:last-child {
    margin-bottom: 0;
  }

  /* ── You may also like ────────────────────────────────────────────────── */

  .fpp__related {
    background: #080808 !important;
    background: var(--black) !important;
    margin-top: 80px;
    padding: 80px 60px;
  }

  .fpp__related-header {
    margin-bottom: 48px;
  }

  .fpp__related-eyebrow {
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: #c9a84c;
    color: var(--gold);
    margin: 0 0 14px;
  }

  .fpp__related-heading {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 52px);
    letter-spacing: 0.06em;
    color: #f0ece4;
    color: var(--white);
    margin: 0;
    line-height: 1;
  }

  .fpp__related-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ── Related cards — fully self-contained, no external CSS dependency ─── */

  .fpp-rel-card {
    background: #161616;
    border: 1px solid rgba(255,255,255,0.07);
    overflow: hidden;
    position: relative;
    z-index: 0;
    display: flex;
    flex-direction: column;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .fpp-rel-card:hover {
    border-color: rgba(201, 168, 76, 0.3);
    transform: translateY(-4px);
    z-index: 1;
  }

  .fpp-rel-card__img-link {
    display: block;
    overflow: hidden;
    text-decoration: none;
  }

  .fpp-rel-card__img-wrap {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #1e1e1e;
  }

  .fpp-rel-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .fpp-rel-card:hover .fpp-rel-card__img {
    transform: scale(1.03);
  }

  .fpp-rel-card__img-placeholder {
    width: 100%;
    height: 100%;
    background: #1e1e1e;
  }

  .fpp-rel-card__body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
    background: #161616;
  }

  .fpp-rel-card__title {
    font-family: 'Cormorant Garamond', serif;
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 300;
    color: #f0ece4;
    color: var(--white);
    margin: 0 0 6px;
    line-height: 1.3;
    text-decoration: none;
  }

  .fpp-rel-card__edition {
    font-family: 'Montserrat', sans-serif;
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c9a84c;
    color: var(--gold);
    margin: 0 0 16px;
  }

  .fpp-rel-card__formats {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .fpp-rel-card__tag {
    padding: 4px 10px;
    border: 1px solid rgba(255,255,255,0.07);
    font-family: 'Montserrat', sans-serif;
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(240,236,228,0.5);
    color: var(--muted);
    background: transparent;
  }

  .fpp-rel-card__price-row {
    margin-top: auto;
    margin-bottom: 16px;
  }

  .fpp-rel-card__price {
    font-family: 'Bebas Neue', sans-serif;
    font-family: var(--font-display);
    font-size: 24px;
    letter-spacing: 0.05em;
    color: #c9a84c;
    color: var(--gold);
    line-height: 1;
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .fpp-rel-card__from {
    font-family: 'Montserrat', sans-serif;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 300;
    color: rgba(240,236,228,0.5);
    color: var(--muted);
    letter-spacing: 0.05em;
  }

  .fpp-rel-card__btn {
    display: block;
    width: 100%;
    padding: 14px;
    background: #c9a84c;
    color: #080808;
    font-family: 'Montserrat', sans-serif;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    transition: background 0.3s ease;
    box-sizing: border-box;
  }

  .fpp-rel-card__btn:hover {
    background: #e8c97a;
  }

  /* ── Mobile ───────────────────────────────────────────────────────────── */

  @media screen and (max-width: 989px) {
    .fpp {
      padding: 60px 40px 100px;
    }

    .fpp__related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .fpp {
      padding: 48px 24px 80px;
    }

    .fpp__related {
      margin-top: 48px;
      padding: 48px 24px;
    }

    .fpp__related-grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('click', function (e) {
    var thumb = e.target.closest('.fpp__thumb');
    if (!thumb) return;

    var gallery = thumb.closest('.fpp__gallery');
    if (!gallery) return;

    var mainImg = gallery.querySelector('.fpp__main-img');
    if (!mainImg) return;

    if (thumb.dataset.src) {
      mainImg.src = thumb.dataset.src;
      mainImg.srcset = thumb.dataset.srcset || '';
      if (thumb.dataset.alt) mainImg.alt = thumb.dataset.alt;
    }

    gallery.querySelectorAll('.fpp__thumb').forEach(function (t) {
      t.classList.remove('fpp__thumb--active');
    });
    thumb.classList.add('fpp__thumb--active');
  });
{% endjavascript %}


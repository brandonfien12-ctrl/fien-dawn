<section class="fien-hero" id="fien-hero">

  {%- comment -%} Video background (optional) {%- endcomment -%}
  <div class="fien-hero__video-wrap" id="fienHeroVideoWrap">
    {%- if section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          class: 'fien-hero__video'
      }}
    {%- else -%}
      <div class="fien-hero__video-placeholder"></div>
    {%- endif -%}
    <div class="fien-hero__video-overlay" aria-hidden="true"></div>
  </div>

  {%- comment -%} Hero content — bottom-left {%- endcomment -%}
  <div class="fien-hero__content">
    <p class="fien-hero__eyebrow">
      {{- section.settings.eyebrow -}}
    </p>

    <h1 class="fien-hero__title">
      {{- section.settings.heading_line_1 -}}
      <span>{{- section.settings.heading_line_2 -}}</span>
    </h1>

    <p class="fien-hero__subtitle">
      {{- section.settings.subtitle -}}
    </p>

    <div class="fien-hero__cta">
      {%- if section.settings.cta_primary_label != blank -%}
        <a
          href="{{ section.settings.cta_primary_url | default: '#fien-collection' }}"
          class="fien-btn fien-btn--primary"
        >
          {{- section.settings.cta_primary_label -}}
        </a>
      {%- endif -%}

    </div>
  </div>

  {%- comment -%} Scroll indicator — bottom-right {%- endcomment -%}
  <div class="fien-hero__scroll" aria-hidden="true">
    <span class="fien-hero__scroll-line"></span>
    <span class="fien-hero__scroll-label">{{ 'sections.fien_hero.scroll_label' | t }}</span>
  </div>

</section>

{% stylesheet %}
  /* ── Hero section ─────────────────────────────────────────────────────── */

  .fien-hero {
    position: relative;
    height: 100vh;
    min-height: 700px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--black);
  }

  /* Video / placeholder layer */
  .fien-hero__video-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .fien-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.45;
    filter: brightness(0.6) saturate(0.8);
  }

  .fien-hero__video-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(105deg, #0a1a0f 0%, #111111 40%, #1a1208 100%);
  }

  /* Dual gradient overlay */
  .fien-hero__video-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(5,5,5,0.6) 0%, rgba(5,5,5,0.3) 45%, rgba(5,5,5,0.82) 85%, #080808 100%),
      linear-gradient(to right, rgba(5,5,5,0.65) 0%, rgba(5,5,5,0.1) 65%);
  }

  /* Content */
  .fien-hero__content {
    position: relative;
    z-index: 2;
    padding: 0 60px 80px;
    max-width: 900px;
  }

  .fien-hero__eyebrow {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 20px;
    opacity: 0;
    animation: fienFadeUp 0.8s 0.3s forwards;
  }

  .fien-hero__title {
    font-family: var(--font-display);
    font-size: clamp(80px, 12vw, 176px);
    line-height: 0.9;
    letter-spacing: 0.04em;
    color: var(--white);
    margin: 0;
    opacity: 0;
    animation: fienFadeUp 0.9s 0.5s forwards;
  }

  .fien-hero__title span {
    color: var(--gold);
    display: block;
  }

  .fien-hero__subtitle {
    font-family: var(--font-serif);
    font-size: clamp(16px, 2vw, 22px);
    font-style: italic;
    font-weight: 300;
    color: var(--muted);
    margin: 24px 0 0;
    max-width: 500px;
    line-height: 1.7;
    opacity: 0;
    animation: fienFadeUp 0.9s 0.7s forwards;
  }

  .fien-hero__cta {
    display: flex;
    gap: 20px;
    margin-top: 44px;
    flex-wrap: wrap;
    opacity: 0;
    animation: fienFadeUp 0.9s 0.9s forwards;
  }

  /* Buttons */
  .fien-btn {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 14px 36px;
    transition: background 0.3s, color 0.3s, border-color 0.3s, transform 0.2s;
    white-space: nowrap;
  }

  .fien-btn--primary {
    background: var(--gold);
    color: #080808;
    border: 1px solid var(--gold);
  }

  .fien-btn--primary:hover {
    background: var(--gold-light);
    border-color: var(--gold-light);
    transform: translateY(-2px);
  }

  /* Scroll indicator */
  .fien-hero__scroll {
    position: absolute;
    bottom: 40px;
    right: 60px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 12px;
    opacity: 0;
    animation: fienFadeIn 1s 1.2s forwards;
  }

  .fien-hero__scroll-line {
    display: block;
    width: 60px;
    height: 1px;
    background: linear-gradient(to right, var(--gold), transparent);
    animation: fienScrollPulse 2s 1.5s infinite;
  }

  .fien-hero__scroll-label {
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Keyframes */
  @keyframes fienFadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes fienFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @keyframes fienScrollPulse {
    0%, 100% { opacity: 0.4; }
    50%       { opacity: 1; }
  }

  /* Mobile */
  @media screen and (max-width: 749px) {
    .fien-hero__content {
      padding: 0 24px 60px;
    }

    .fien-hero__scroll {
      right: 24px;
      bottom: 24px;
    }

    .fien-hero__cta {
      flex-direction: column;
      gap: 12px;
    }

    .fien-btn {
      text-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Fien hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Outdoor & wildlife photography"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "The untold"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2 (gold)",
      "default": "Stories."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Limited-edition fine art prints from the wilderness. Each image a single moment, made permanent."
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary button label",
      "default": "View prints"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary button URL",
      "info": "Leave blank to scroll to the prints carousel"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video"
    }
  ],
  "presets": [
    {
      "name": "Fien hero"
    }
  ]
}
{% endschema %}

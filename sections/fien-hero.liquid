<section class="fien-hero" id="fien-hero">

  {%- comment -%} Video background (optional) {%- endcomment -%}
  <div class="fien-hero__video-wrap" id="fienHeroVideoWrap">
    {%- if section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          class: 'fien-hero__video'
      }}
    {%- else -%}
      <div class="fien-hero__video-placeholder"></div>
    {%- endif -%}
    <div class="fien-hero__video-overlay" aria-hidden="true"></div>
  </div>

  {%- comment -%} Hero content — bottom-left {%- endcomment -%}
  <div class="fien-hero__content">
    <p class="fien-hero__eyebrow">
      {{- section.settings.eyebrow -}}
    </p>

    <h1 class="fien-hero__title">
      {{- section.settings.heading_line_1 -}}
      <span>{{- section.settings.heading_line_2 -}}</span>
    </h1>

    <p class="fien-hero__subtitle">
      {{- section.settings.subtitle -}}
    </p>

    <div class="fien-hero__cta">
      {%- if section.settings.portfolio_label != blank -%}
        {%- comment -%}
          Anchors down to the sections on THIS page (#fien-films, #fien-photography)
          rather than the separate /pages/videography and /pages/photography —
          the site's global `scroll-behavior: smooth` (layout/theme.liquid) makes
          this glide rather than jump.
        {%- endcomment -%}
        {%- liquid
          assign hero_cta1_url = section.settings.cta1_url | default: '#fien-films'
          assign hero_cta2_url = section.settings.cta2_url | default: '#fien-photography'
        -%}
        <div class="fien-hero__dropdown" data-fien-dropdown>
          <button
            type="button"
            class="fien-btn fien-btn--primary fien-hero__dropdown-toggle"
            aria-haspopup="true"
            aria-expanded="false"
            data-fien-dropdown-toggle
          >
            {{- section.settings.portfolio_label -}}
            <span class="fien-hero__caret" aria-hidden="true"></span>
          </button>
          <ul class="fien-hero__submenu" role="list">
            {% render 'fien-portfolio-links',
              item_class: 'fien-hero__submenu-link',
              l1_label: section.settings.cta1_label,
              l1_url: hero_cta1_url,
              l2_label: section.settings.cta2_label,
              l2_url: hero_cta2_url
            %}
          </ul>
        </div>
      {%- endif -%}

    </div>
  </div>

  {%- comment -%} Scroll indicator — bottom-right {%- endcomment -%}
  <div class="fien-hero__scroll" aria-hidden="true">
    <span class="fien-hero__scroll-line"></span>
    <span class="fien-hero__scroll-label">{{ 'sections.fien_hero.scroll_label' | t }}</span>
  </div>

</section>

{% stylesheet %}
  /* ── Hero section ─────────────────────────────────────────────────────── */

  .fien-hero {
    position: relative;
    height: 100vh;
    min-height: 700px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--black);
  }

  /* Video / placeholder layer */
  .fien-hero__video-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .fien-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.45;
    filter: brightness(0.6) saturate(0.8);
  }

  .fien-hero__video-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(105deg, #0a1a0f 0%, #111111 40%, #1a1208 100%);
  }

  /* Dual gradient overlay */
  .fien-hero__video-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(5,5,5,0.6) 0%, rgba(5,5,5,0.3) 45%, rgba(5,5,5,0.82) 85%, #080808 100%),
      linear-gradient(to right, rgba(5,5,5,0.65) 0%, rgba(5,5,5,0.1) 65%);
  }

  /* Content */
  .fien-hero__content {
    position: relative;
    z-index: 2;
    padding: 0 60px 80px;
    max-width: 900px;
  }

  .fien-hero__eyebrow {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 20px;
    opacity: 0;
    animation: fienFadeUp 0.8s 0.3s forwards;
  }

  .fien-hero__title {
    font-family: var(--font-display);
    font-size: clamp(80px, 12vw, 176px);
    line-height: 0.9;
    letter-spacing: 0.04em;
    color: var(--white);
    margin: 0;
    opacity: 0;
    animation: fienFadeUp 0.9s 0.5s forwards;
  }

  .fien-hero__title span {
    color: var(--gold);
    display: block;
  }

  .fien-hero__subtitle {
    font-family: var(--font-serif);
    font-size: clamp(16px, 2vw, 22px);
    font-style: italic;
    font-weight: 300;
    color: var(--muted);
    margin: 24px 0 0;
    max-width: 500px;
    line-height: 1.7;
    opacity: 0;
    animation: fienFadeUp 0.9s 0.7s forwards;
  }

  .fien-hero__cta {
    display: flex;
    gap: 20px;
    margin-top: 44px;
    flex-wrap: wrap;
    opacity: 0;
    animation: fienFadeUp 0.9s 0.9s forwards;
  }

  /* Buttons */
  .fien-btn {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 14px 36px;
    transition: background 0.3s, color 0.3s, border-color 0.3s, transform 0.2s;
    white-space: nowrap;
  }

  .fien-btn--primary {
    background: var(--gold);
    color: #080808;
    border: 1px solid var(--gold);
  }

  .fien-btn--primary:hover {
    background: var(--gold-light);
    border-color: var(--gold-light);
    transform: translateY(-2px);
  }

  /* "View the portfolio" dropdown — hover / keyboard focus opens it via CSS;
     JS below adds click/tap toggle plus outside-click and Escape to close. */
  .fien-hero__dropdown {
    position: relative;
  }

  .fien-hero__dropdown-toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    border: 1px solid var(--gold);
  }

  .fien-hero__caret {
    width: 7px;
    height: 7px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.3s ease;
    margin-top: -3px;
  }

  .fien-hero__dropdown:hover .fien-hero__caret,
  .fien-hero__dropdown:focus-within .fien-hero__caret,
  .fien-hero__dropdown.is-open .fien-hero__caret {
    transform: rotate(-135deg);
    margin-top: 2px;
  }

  /* Opens upward, not downward — the hero button sits near the bottom of a
     100vh section with overflow:hidden (needed to clip the background
     video), so a downward menu gets clipped before it's fully visible. */
  .fien-hero__submenu {
    position: absolute;
    bottom: 100%;
    left: 0;
    margin: 0 0 14px;
    padding: 8px 0;
    min-width: 220px;
    list-style: none;
    background: var(--dark);
    border: 1px solid var(--border);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s ease;
    transform: translateY(6px);
    z-index: 50;
  }

  /* Invisible bridge so the pointer can cross the gap without closing */
  .fien-hero__submenu::before {
    content: '';
    position: absolute;
    bottom: -14px;
    left: 0;
    right: 0;
    height: 14px;
  }

  .fien-hero__dropdown:hover .fien-hero__submenu,
  .fien-hero__dropdown:focus-within .fien-hero__submenu,
  .fien-hero__dropdown.is-open .fien-hero__submenu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .fien-hero__submenu-link {
    display: block;
    padding: 12px 28px;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .fien-hero__submenu-link:hover {
    color: var(--gold);
    background: var(--mid);
  }

  /* Scroll indicator */
  .fien-hero__scroll {
    position: absolute;
    bottom: 40px;
    right: 60px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 12px;
    opacity: 0;
    animation: fienFadeIn 1s 1.2s forwards;
  }

  .fien-hero__scroll-line {
    display: block;
    width: 60px;
    height: 1px;
    background: linear-gradient(to right, var(--gold), transparent);
    animation: fienScrollPulse 2s 1.5s infinite;
  }

  .fien-hero__scroll-label {
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Keyframes */
  @keyframes fienFadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes fienFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @keyframes fienScrollPulse {
    0%, 100% { opacity: 0.4; }
    50%       { opacity: 1; }
  }

  /* Mobile */
  @media screen and (max-width: 749px) {
    .fien-hero__content {
      padding: 0 24px 60px;
    }

    .fien-hero__scroll {
      right: 24px;
      bottom: 24px;
    }

    .fien-hero__cta {
      flex-direction: column;
      gap: 12px;
    }

    .fien-btn {
      text-align: center;
    }
  }
{% endstylesheet %}

{% javascript %}
  // "View the portfolio" dropdown. Hover / keyboard focus opens it via CSS;
  // this adds click-and-tap toggle plus outside-click and Escape to close.
  (function () {
    var dropdowns = document.querySelectorAll('.fien-hero [data-fien-dropdown]');
    if (!dropdowns.length) return;

    function closeAll() {
      dropdowns.forEach(function (dd) {
        dd.classList.remove('is-open');
        var t = dd.querySelector('[data-fien-dropdown-toggle]');
        if (t) t.setAttribute('aria-expanded', 'false');
      });
    }

    dropdowns.forEach(function (dd) {
      var toggle = dd.querySelector('[data-fien-dropdown-toggle]');
      if (!toggle) return;
      toggle.addEventListener('click', function (event) {
        event.preventDefault();
        var isOpen = dd.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    });

    document.addEventListener('click', function (event) {
      dropdowns.forEach(function (dd) {
        if (!dd.contains(event.target)) {
          dd.classList.remove('is-open');
          var t = dd.querySelector('[data-fien-dropdown-toggle]');
          if (t) t.setAttribute('aria-expanded', 'false');
        }
      });
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') closeAll();
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Fien hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Outdoor & wildlife photography"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "The untold"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2 (gold)",
      "default": "Stories."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "They say a picture is worth a thousand words — but what if the most powerful ones were never spoken at all?"
    },
    {
      "type": "header",
      "content": "Portfolio dropdown"
    },
    {
      "type": "text",
      "id": "portfolio_label",
      "label": "Dropdown button label",
      "default": "View the portfolio"
    },
    {
      "type": "text",
      "id": "cta1_label",
      "label": "Link 1 label",
      "default": "Films"
    },
    {
      "type": "url",
      "id": "cta1_url",
      "label": "Link 1 URL",
      "info": "Defaults to #fien-films (scrolls down to the Films section on this page) if left blank"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Link 2 label",
      "default": "Photography"
    },
    {
      "type": "url",
      "id": "cta2_url",
      "label": "Link 2 URL",
      "info": "Defaults to #fien-photography (scrolls down to the Photography section on this page) if left blank"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video"
    }
  ],
  "presets": [
    {
      "name": "Fien hero"
    }
  ]
}
{% endschema %}

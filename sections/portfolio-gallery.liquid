<section class="portfolio-gallery" id="portfolio-gallery-{{ section.id }}">

  {%- if section.settings.heading != blank or section.settings.intro != blank -%}
    <header class="portfolio-gallery__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="portfolio-gallery__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="portfolio-gallery__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="portfolio-gallery__intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}
    </header>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="portfolio-gallery__grid" style="--columns: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <div class="portfolio-gallery__item" {{ block.shopify_attributes }}>
          {% render 'fien-media-item',
            image: block.settings.image,
            video: block.settings.video,
            video_url: block.settings.video_url,
            title: block.settings.title,
            caption: block.settings.caption
          %}
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    <p class="portfolio-gallery__empty">{{ 'sections.portfolio_gallery.empty' | t }}</p>
  {%- endif -%}

</section>

{% stylesheet %}
  .portfolio-gallery {
    background: var(--black);
    padding: 120px 60px;
  }

  .portfolio-gallery__header {
    max-width: 760px;
    margin: 0 auto 64px;
    text-align: center;
  }

  .portfolio-gallery__eyebrow {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 20px;
  }

  .portfolio-gallery__heading {
    font-family: var(--font-display);
    font-size: clamp(48px, 8vw, 96px);
    line-height: 0.95;
    letter-spacing: 0.04em;
    color: var(--white);
    margin: 0;
  }

  .portfolio-gallery__intro {
    font-family: var(--font-serif);
    font-size: clamp(16px, 1.6vw, 20px);
    font-style: italic;
    color: var(--muted);
    margin: 24px 0 0;
    line-height: 1.7;
  }

  .portfolio-gallery__grid {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(var(--columns, 3), 1fr);
    gap: 24px;
  }

  .portfolio-gallery__empty {
    text-align: center;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--muted);
  }

  @media screen and (max-width: 989px) {
    .portfolio-gallery__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .portfolio-gallery {
      padding: 80px 24px;
    }

    .portfolio-gallery__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Portfolio gallery",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Photography"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    }
  ],
  "max_blocks": 50,
  "blocks": [
    {
      "type": "media",
      "name": "Media",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (uploaded)"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "Video URL (YouTube or Vimeo)",
          "accept": ["youtube", "vimeo"]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title (optional)"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Portfolio gallery",
      "blocks": [
        { "type": "media" },
        { "type": "media" },
        { "type": "media" }
      ]
    }
  ]
}
{% endschema %}

{{ 'component-modal-video.css' | asset_url | stylesheet_tag }}

<section class="fpg" id="fien-photography">
  <div class="fpg__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="fpg__eyebrow">{{- section.settings.eyebrow -}}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="fpg__heading">{{- section.settings.heading -}}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="fpg__subtitle">{{- section.settings.subtitle -}}</p>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="fpg__grid">
      {%- for block in section.blocks -%}
        <div
          class="fpg__cell{% if block.settings.feature %} fpg__cell--feature{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <modal-opener data-modal="#FpgModal-{{ block.id }}">
            <button
              type="button"
              class="fpg__link full-unstyled-link"
              aria-haspopup="dialog"
              aria-label="{{ 'sections.fien_photo_collage.view_image' | t }}"
            >
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1800
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800, 1000, 1400, 1800',
                    sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                    class: 'fpg__image'
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg fpg__placeholder' }}
              {%- endif -%}
              {%- if block.settings.caption != blank -%}
                <span class="fpg__caption">{{ block.settings.caption }}</span>
              {%- endif -%}
            </button>
          </modal-opener>

          <modal-dialog id="FpgModal-{{ block.id }}" class="modal-video media-modal color-{{ settings.color_schemes | first }}">
            <div
              class="modal-video__content fpg__modal-content"
              role="dialog"
              aria-label="{{ block.settings.caption | escape }}"
              aria-modal="true"
              tabindex="-1"
            >
              <button
                id="ModalClose-{{ block.id }}"
                type="button"
                class="modal-video__toggle"
                aria-label="{{ 'accessibility.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 2600
                  | image_tag:
                    loading: 'lazy',
                    widths: '750, 1000, 1500, 2000, 2600',
                    sizes: '90vw',
                    class: 'fpg__modal-image'
                }}
              {%- endif -%}
              {%- if block.settings.caption != blank -%}
                <p class="fpg__modal-caption">{{ block.settings.caption }}</p>
              {%- endif -%}
            </div>
          </modal-dialog>
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    <p class="fpg__empty page-width">{{ 'sections.fien_photo_collage.empty' | t }}</p>
  {%- endif -%}
</section>

{% stylesheet %}
  /* ── Photo collage ─────────────────────────────────────────────────────── */

  .fpg {
    background: var(--black);
    padding: 120px 0;
  }

  /* Matches .ffc__header in fien-featured-films.liquid exactly, so the
     "Films" and "Photography" section intros on the homepage read as one
     consistent system rather than two different styles. */
  .fpg__header {
    margin-bottom: 64px;
    max-width: 700px;
    padding: 0 60px;
  }

  .fpg__eyebrow {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 16px;
  }

  .fpg__heading {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 64px);
    letter-spacing: 0.06em;
    line-height: 1;
    color: var(--white);
    margin: 0 0 24px;
  }

  .fpg__subtitle {
    font-family: var(--font-serif);
    font-size: 18px;
    font-style: italic;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.8;
    margin: 0;
  }

  .fpg__empty {
    text-align: center;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--muted);
  }

  /* Pinterest-style masonry — every photo keeps its own natural aspect
     ratio (no cropping). Portrait shots run tall, landscape shots run
     short, and everything just packs around them automatically. Reorder,
     add, or remove photos by dragging blocks in the theme editor sidebar;
     the layout re-flows on its own. Check "Feature" on a block to break
     it out full width. */
  .fpg__grid {
    column-count: 3;
    column-gap: 4px;
    padding: 0 4px;
  }

  .fpg__cell {
    position: relative;
    overflow: hidden;
    background: var(--dark);
    break-inside: avoid;
    margin-bottom: 4px;
  }

  .fpg__cell--feature {
    column-span: all;
  }

  .fpg__link {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
  }

  .fpg__image,
  .fpg__placeholder {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.7s ease;
  }

  .fpg__cell::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(8, 8, 8, 0.7) 0%, rgba(8, 8, 8, 0) 40%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .fpg__cell:hover::after {
    opacity: 1;
  }

  .fpg__cell:hover .fpg__image {
    transform: scale(1.05);
  }

  .fpg__caption {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 16px;
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--white);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .fpg__cell:hover .fpg__caption {
    opacity: 1;
    transform: translateY(0);
  }

  .fpg__modal-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 24px;
  }

  .fpg__modal-image {
    display: block;
    max-width: 90vw;
    max-height: 80vh;
    width: auto;
    height: auto;
    margin: 0 auto;
  }

  .fpg__modal-caption {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--muted);
    margin: 20px 0 0;
    text-align: center;
  }

  @media screen and (max-width: 989px) {
    .fpg__grid {
      column-count: 2;
    }
  }

  @media screen and (max-width: 749px) {
    .fpg {
      padding: 80px 0;
    }

    .fpg__header {
      padding: 0 24px;
      margin-bottom: 48px;
    }

    /* Two columns, not one. At column-count: 1 the masonry stopped reading as
       a collage on phones — it became a single stack showing roughly one photo
       per screen. Two columns keeps the packed, mixed-height look, and a
       featured block still spans the full width via column-span: all. */
    .fpg__grid {
      column-count: 2;
      column-gap: 2px;
      padding: 0 2px;
    }

    .fpg__cell {
      margin-bottom: 2px;
    }

    /* Captions are always visible on touch (no hover), but the cells are now
       half-width, so pull the insets in to stop short captions wrapping. */
    .fpg__caption {
      opacity: 1;
      transform: none;
      left: 10px;
      right: 10px;
      bottom: 10px;
    }

    .fpg__cell::after {
      opacity: 0.5;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Photo collage",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "The full collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Photography"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "A working archive of images from the field."
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "checkbox",
          "id": "feature",
          "label": "Feature (full width)",
          "default": false
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption (optional)"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Photo collage",
      "blocks": [
        { "type": "photo", "settings": { "feature": true } },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}

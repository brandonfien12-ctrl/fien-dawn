<section class="landing-hero" id="landing-hero-{{ section.id }}">

  {%- comment -%} Logo {%- endcomment -%}
  {%- if section.settings.logo != blank -%}
    <div class="landing-hero__logo" style="--logo-width: {{ section.settings.logo_width }}px;">
      {{
        section.settings.logo
        | image_url: width: 900
        | image_tag:
          loading: 'eager',
          class: 'landing-hero__logo-img',
          widths: '200, 300, 450, 600, 900',
          sizes: '(max-width: 749px) 60vw, 450px'
      }}
    </div>
  {%- endif -%}

  {%- comment -%} About {%- endcomment -%}
  {%- if section.settings.about_text != blank or section.settings.about_image != blank -%}
    <div class="landing-hero__about{% if section.settings.about_image != blank %} landing-hero__about--split{% endif %}">
      {%- if section.settings.about_image != blank -%}
        <div class="landing-hero__about-media">
          {{
            section.settings.about_image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              class: 'landing-hero__about-img',
              widths: '400, 600, 800, 1200',
              sizes: '(min-width: 750px) 45vw, 100vw'
          }}
        </div>
      {%- endif -%}

      {%- if section.settings.about_text != blank -%}
        <div class="landing-hero__about-text rte">
          {{ section.settings.about_text }}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%} "View portfolio" dropdown — hover / focus opens (CSS), tap toggles (JS).
    Links and labels are the three CTA settings below, editable in the customizer. {%- endcomment -%}
  <div class="landing-hero__cta">
    <div class="landing-hero__dropdown" data-fien-dropdown>
      <button
        type="button"
        class="fien-btn fien-btn--primary landing-hero__dropdown-toggle"
        aria-haspopup="true"
        aria-expanded="false"
        data-fien-dropdown-toggle
      >
        {{- section.settings.portfolio_label -}}
        <span class="landing-hero__caret" aria-hidden="true"></span>
      </button>
      <ul class="landing-hero__submenu" role="list">
        {% render 'fien-portfolio-links',
          item_class: 'landing-hero__submenu-link',
          l1_label: section.settings.cta1_label,
          l1_url: section.settings.cta1_url,
          l2_label: section.settings.cta2_label,
          l2_url: section.settings.cta2_url,
          l3_label: section.settings.cta3_label,
          l3_url: section.settings.cta3_url
        %}
      </ul>
    </div>
  </div>

  {%- comment -%} Repeatable photo / video blocks — add, remove or reorder freely {%- endcomment -%}
  {%- if section.blocks.size > 0 -%}
    <div class="landing-hero__grid" style="--columns: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <div class="landing-hero__grid-item" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'photo' -%}
              {% render 'fien-media-item',
                image: block.settings.image,
                caption: block.settings.caption
              %}
            {%- when 'video' -%}
              {% render 'fien-media-item',
                video: block.settings.video,
                video_url: block.settings.video_url,
                caption: block.settings.caption
              %}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

</section>

{% stylesheet %}
  .landing-hero {
    background: var(--black);
    padding: 120px 60px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 64px;
  }

  .landing-hero__logo {
    text-align: center;
  }

  .landing-hero__logo-img {
    width: var(--logo-width, 320px);
    max-width: 80vw;
    height: auto;
    display: inline-block;
  }

  .landing-hero__about {
    max-width: 760px;
    width: 100%;
  }

  .landing-hero__about--split {
    max-width: 1100px;
    display: grid;
    grid-template-columns: 45% 1fr;
    gap: 48px;
    align-items: center;
  }

  .landing-hero__about-img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
  }

  .landing-hero__about-text {
    font-family: var(--font-serif);
    font-size: clamp(16px, 1.6vw, 20px);
    line-height: 1.8;
    color: var(--white);
  }

  .landing-hero__cta {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .landing-hero__dropdown {
    position: relative;
  }

  .landing-hero__dropdown-toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
  }

  .landing-hero__caret {
    width: 7px;
    height: 7px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.3s ease;
    margin-top: -3px;
  }

  .landing-hero__dropdown:hover .landing-hero__caret,
  .landing-hero__dropdown:focus-within .landing-hero__caret,
  .landing-hero__dropdown.is-open .landing-hero__caret {
    transform: rotate(-135deg);
    margin-top: 2px;
  }

  .landing-hero__submenu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(-6px);
    min-width: 220px;
    margin: 14px 0 0;
    padding: 8px 0;
    list-style: none;
    background: var(--dark);
    border: 1px solid var(--border);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s ease;
    z-index: 50;
  }

  /* Invisible bridge so the pointer can cross the gap without closing */
  .landing-hero__submenu::before {
    content: '';
    position: absolute;
    top: -14px;
    left: 0;
    right: 0;
    height: 14px;
  }

  .landing-hero__dropdown:hover .landing-hero__submenu,
  .landing-hero__dropdown:focus-within .landing-hero__submenu,
  .landing-hero__dropdown.is-open .landing-hero__submenu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .landing-hero__submenu-link {
    display: block;
    padding: 12px 28px;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .landing-hero__submenu-link:hover {
    color: var(--gold);
    background: var(--mid);
  }

  .landing-hero__grid {
    width: 100%;
    max-width: 1400px;
    display: grid;
    grid-template-columns: repeat(var(--columns, 3), 1fr);
    gap: 24px;
  }

  @media screen and (max-width: 989px) {
    .landing-hero__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .landing-hero {
      padding: 80px 24px;
      gap: 48px;
    }

    .landing-hero__about--split {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .landing-hero__cta {
      flex-direction: column;
      width: 100%;
    }

    .landing-hero__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% javascript %}
  // "View portfolio" dropdown. Hover / keyboard focus opens it via CSS; this
  // adds click-and-tap toggle plus outside-click and Escape to close.
  (function () {
    var dropdowns = document.querySelectorAll('.landing-hero [data-fien-dropdown]');
    if (!dropdowns.length) return;

    function closeAll() {
      dropdowns.forEach(function (dd) {
        dd.classList.remove('is-open');
        var t = dd.querySelector('[data-fien-dropdown-toggle]');
        if (t) t.setAttribute('aria-expanded', 'false');
      });
    }

    dropdowns.forEach(function (dd) {
      var toggle = dd.querySelector('[data-fien-dropdown-toggle]');
      if (!toggle) return;
      toggle.addEventListener('click', function (event) {
        event.preventDefault();
        var isOpen = dd.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    });

    document.addEventListener('click', function (event) {
      dropdowns.forEach(function (dd) {
        if (!dd.contains(event.target)) {
          dd.classList.remove('is-open');
          var t = dd.querySelector('[data-fien-dropdown-toggle]');
          if (t) t.setAttribute('aria-expanded', 'false');
        }
      });
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') closeAll();
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Landing hero",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 120,
      "max": 640,
      "step": 10,
      "unit": "px",
      "default": 320
    },
    {
      "type": "header",
      "content": "About"
    },
    {
      "type": "richtext",
      "id": "about_text",
      "label": "About text",
      "default": "<p>Brandon Fien is an outdoor and wildlife fine art photographer capturing the untold stories of the natural world.</p>"
    },
    {
      "type": "image_picker",
      "id": "about_image",
      "label": "About image (optional)"
    },
    {
      "type": "header",
      "content": "Portfolio dropdown"
    },
    {
      "type": "text",
      "id": "portfolio_label",
      "label": "Dropdown button label",
      "default": "View portfolio"
    },
    {
      "type": "text",
      "id": "cta1_label",
      "label": "Link 1 label",
      "default": "Photography"
    },
    {
      "type": "url",
      "id": "cta1_url",
      "label": "Link 1 URL"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Link 2 label",
      "default": "Videography"
    },
    {
      "type": "url",
      "id": "cta2_url",
      "label": "Link 2 URL"
    },
    {
      "type": "text",
      "id": "cta3_label",
      "label": "Link 3 label",
      "default": "Client Portal"
    },
    {
      "type": "url",
      "id": "cta3_url",
      "label": "Link 3 URL"
    },
    {
      "type": "header",
      "content": "Media grid"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    }
  ],
  "max_blocks": 50,
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption (optional)"
        }
      ]
    },
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video (uploaded)"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "Video URL (YouTube or Vimeo)",
          "accept": ["youtube", "vimeo"]
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing hero",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}

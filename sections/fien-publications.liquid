{%- comment -%}
  Desktop pages of three. (n + 2) / 3 with Liquid's integer division is
  ceil(n / 3).

  One dot is rendered per cover rather than per page, because the two
  breakpoints need different numbers of them — desktop pages three covers at a
  time, mobile moves one at a time. The JS hides whichever dots the current
  breakpoint doesn't need; they start hidden at the desktop count so the
  desktop row is already correct on first paint.
{%- endcomment -%}
{%- liquid
  assign desktop_page_count = section.blocks.size | plus: 2 | divided_by: 3
-%}

<section
  class="fpb"
  id="fien-publications"
  style="--fpb-gap: {{ section.settings.gap }}px; --fpb-ratio: {{ section.settings.cover_ratio }}; --fpb-scale: {{ section.settings.cover_scale | default: 86 }}%; --fpb-mobile-cover: {{ section.settings.mobile_cover_width | default: 82 }}vw;"
>
  {%- comment -%} Section header — matches .ffc__header and .fpg__header {%- endcomment -%}
  <div class="fpb__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="fpb__eyebrow">{{- section.settings.eyebrow -}}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="fpb__heading">{{- section.settings.heading -}}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="fpb__subtitle">{{- section.settings.subtitle -}}</p>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div
      class="fpb__carousel{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      data-section="{{ section.id }}"
    >
      <button
        class="fpb__arrow fpb__arrow--prev"
        type="button"
        aria-label="{{ 'sections.fien_publications.prev' | t }}"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M13 4L7 10L13 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      {%- comment -%}
        Native scroll-snap track rather than a transform-driven carousel: it
        gives swipe on touch for free, so the 3-up view behaves identically on
        mobile and desktop, and it degrades to a plain scroller if the JS
        never runs.
      {%- endcomment -%}
      <ul
        class="fpb__track"
        role="list"
        tabindex="0"
        aria-label="{{ 'sections.fien_publications.carousel_label' | t }}"
      >
        {%- for block in section.blocks -%}
          {%- comment -%}
            Covers link out to the publication when a URL is set, and are
            otherwise inert — a cover with nowhere to go should not look
            clickable, so the wrapper element changes rather than the styling.
          {%- endcomment -%}
          {%- liquid
            if block.settings.url != blank
              assign wrapper = 'a'
            else
              assign wrapper = 'div'
            endif
          -%}
          <li class="fpb__item" {{ block.shopify_attributes }}>
            <{{ wrapper }}
              class="fpb__cover"
              {% if wrapper == 'a' %}
                href="{{ block.settings.url }}"
              {% endif %}
            >
              {%- if block.settings.image != blank -%}
                {%- comment -%}
                  Mobile shows one cover at roughly 82vw against desktop's
                  28vw, so sizes has to branch at the same breakpoint as the
                  CSS — left at 28vw, phones would fetch an image a third of
                  the width they display it at.
                {%- endcomment -%}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 400, 600, 800, 1000, 1200',
                    sizes: '(max-width: 749px) 82vw, 28vw',
                    class: 'fpb__image'
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg fpb__placeholder' }}
              {%- endif -%}
            </{{ wrapper }}>

            {%- if block.settings.title != blank or block.settings.issue != blank -%}
              <div class="fpb__meta">
                {%- if block.settings.title != blank -%}
                  <p class="fpb__title">{{ block.settings.title }}</p>
                {%- endif -%}
                {%- if block.settings.issue != blank -%}
                  <p class="fpb__issue">{{ block.settings.issue }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      <button
        class="fpb__arrow fpb__arrow--next"
        type="button"
        aria-label="{{ 'sections.fien_publications.next' | t }}"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M7 4L13 10L7 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="fpb__dots" role="tablist" aria-label="{{ 'sections.fien_publications.dots_label' | t }}">
        {%- for block in section.blocks -%}
          <button
            class="fpb__dot{% if forloop.first %} fpb__dot--active{% endif %}"
            type="button"
            role="tab"
            data-page="{{ forloop.index0 }}"
            aria-label="{{ 'sections.fien_publications.go_to_page' | t: index: forloop.index }}"
            {% if forloop.first %}
              aria-selected="true"
            {% else %}
              aria-selected="false"
            {% endif %}
            {% if forloop.index0 >= desktop_page_count %}hidden{% endif %}
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- else -%}
    <p class="fpb__empty page-width">{{ 'sections.fien_publications.empty' | t }}</p>
  {%- endif -%}
</section>

{% stylesheet %}
  /* ── Publications ──────────────────────────────────────────────────────── */

  .fpb {
    background: var(--deep);
    padding: 120px 60px;
  }

  /* Matches .ffc__header and .fpg__header so the Films / Publications /
     Photography intros on the homepage read as one consistent system. */
  .fpb__header {
    margin-bottom: 64px;
    max-width: 700px;
  }

  .fpb__eyebrow {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 16px;
  }

  .fpb__heading {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 64px);
    letter-spacing: 0.06em;
    line-height: 1;
    color: var(--white);
    margin: 0 0 24px;
  }

  .fpb__subtitle {
    font-family: var(--font-serif);
    font-size: 18px;
    font-style: italic;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.8;
    margin: 0;
  }

  .fpb__empty {
    text-align: center;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--muted);
  }

  /* Arrows flank the track, matching .ffc__carousel in fien-featured-films. */
  .fpb__carousel {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fpb__track {
    display: flex;
    gap: var(--fpb-gap);
    align-items: start;
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .fpb__track::-webkit-scrollbar {
    display: none;
  }

  /* Exactly three covers in view, at every width — subtracting the two
     gutters that sit between them before dividing keeps the spacing even
     instead of letting the gaps eat into the covers. Deliberately not
     inside a media query: the 3-up view is identical on mobile. */
  .fpb__item {
    flex: 0 0 calc((100% - (2 * var(--fpb-gap))) / 3);
    display: flex;
    flex-direction: column;
    min-width: 0;
    scroll-snap-align: start;
  }

  /* The frame is the fixed-ratio box; the cover image is contained inside it
     rather than cropped. Magazine covers carry their masthead at the top
     edge, so cropping to fill would cut the title off — contain keeps every
     cover whole while the frames stay identically sized. */
  /* Sized as a share of its slot rather than filling it, so the covers can be
     dialled down without disturbing the 3-up rhythm — the slots stay equal
     and the covers stay centred in them, so the spacing stays even. The
     credit line takes the same width so it keeps aligning to the cover's
     edges rather than the slot's. */
  .fpb__cover,
  .fpb__meta {
    width: var(--fpb-scale);
    margin-left: auto;
    margin-right: auto;
  }

  .fpb__cover {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: var(--fpb-ratio);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--dark);
    transition: border-color 0.4s ease, transform 0.4s ease;
  }

  .fpb__cover:hover {
    border-color: rgba(201, 168, 76, 0.3);
    transform: translateY(-4px);
  }

  .fpb__image,
  .fpb__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .fpb__meta {
    margin-top: 16px;
  }

  .fpb__title {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--white);
    margin: 0;
  }

  .fpb__issue {
    font-family: var(--font-serif);
    font-size: 15px;
    font-style: italic;
    color: var(--muted);
    margin: 6px 0 0;
  }

  /* Matches .ffc__arrow in fien-featured-films. */
  .fpb__arrow {
    position: relative;
    z-index: 20;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--gold);
    background: transparent;
    color: var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, opacity 0.2s ease;
    margin: 0 16px;
  }

  .fpb__arrow:hover {
    background: var(--gold);
    color: #080808;
  }

  /* At either end the arrow stays in place rather than disappearing, so the
     track never shifts sideways mid-browse. */
  .fpb__arrow[disabled] {
    opacity: 0.25;
    cursor: default;
  }

  .fpb__arrow[disabled]:hover {
    background: transparent;
    color: var(--gold);
  }

  /* Matches .ffc__dots in fien-featured-films. */
  .fpb__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 40px;
    /* A full 50 covers is 17 pages, which overruns a phone on one line. */
    flex-wrap: wrap;
    row-gap: 8px;
  }

  .fpb__dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: var(--border);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: width 0.3s ease, background 0.3s ease;
  }

  .fpb__dot--active {
    width: 24px;
    background: var(--gold);
  }

  /* Hidden by the JS — the dots this breakpoint doesn't need, and the whole row
     when everything fits in a single page. Both stated explicitly because the
     UA stylesheet's [hidden] rule loses to the display declarations above. */
  .fpb__dot[hidden],
  .fpb__dots[hidden] {
    display: none;
  }

  /* ── Mobile: edge-to-edge peek carousel ────────────────────────────────────
     Three covers across a phone left each one about 57px wide, which is
     unreadable for a magazine cover. Mobile instead shows a single large cover
     with the next one breaking the right edge, so the peek is what signals
     there is more to swipe — the arrows are dropped rather than shrunk,
     because at this size they cost more width than they earn.
     ───────────────────────────────────────────────────────────────────────── */
  @media screen and (max-width: 749px) {
    /* No horizontal padding on the section: the track has to reach both screen
       edges for the peek to sit flush against the right one. The inset the
       padding used to provide moves onto the header and the track itself. */
    .fpb {
      padding: 64px 0;
    }

    /* The header was taking a large share of the section's height before the
       first cover appeared: desktop's gaps between eyebrow, heading and
       subtitle are generous at this width, and the subtitle's 1.8 line-height
       runs to three lines on a phone. Tightening those, and the gap down to
       the track, hands the vertical room back to the covers.

       The 20px inset matches the track's padding-inline, so the heading's left
       edge lines up with the first cover's rather than sitting 4px inside it. */
    .fpb__header {
      margin-bottom: 28px;
      padding: 0 20px;
    }

    .fpb__eyebrow {
      margin-bottom: 10px;
    }

    .fpb__heading {
      margin-bottom: 12px;
    }

    .fpb__subtitle {
      font-size: 16px;
      line-height: 1.55;
    }

    .fpb__dots {
      margin-top: 28px;
    }

    /* Swipe is the interaction on touch; the dots still give direct access to
       any cover, so nothing is only reachable by the arrows. */
    .fpb__arrow {
      display: none;
    }

    /* padding-inline insets the first and last cover so neither is jammed
       against a screen edge, while scroll-padding-inline moves the snap line
       in by the same amount — without it the snapped cover would align to the
       viewport edge and sit under the inset instead of inside it. */
    .fpb__track {
      gap: 12px;
      padding-inline: 20px;
      scroll-padding-inline: 20px;
    }

    /* The cover width is a share of the viewport rather than of the track, so
       whatever is left over after one cover plus the gap becomes the peek. */
    .fpb__item {
      flex: 0 0 var(--fpb-mobile-cover);
    }

    /* Covers fill their slot here. The desktop cover-size setting exists to
       tune the spacing of the 3-up row, which no longer applies with a single
       cover in view — applying it would only shrink the covers again. */
    .fpb__cover,
    .fpb__meta {
      width: 100%;
    }

    .fpb__meta {
      margin-top: 14px;
    }

    /* The covers are large now, so the credit lines no longer need shrinking
       to stop every title wrapping. */
    .fpb__title {
      font-size: 11px;
      letter-spacing: 0.18em;
    }

    .fpb__issue {
      font-size: 14px;
      margin-top: 5px;
    }

    /* No hover on touch, so the lift only fires on tap and reads as a glitch. */
    .fpb__cover:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  // Publications carousel.
  //
  // Scrolling is native (scroll-snap), so this only wires the arrows and dots
  // to it and mirrors the scroll position back into their state. Nothing here
  // drives the scroll position on its own, which is what keeps swipe on touch
  // and the arrows on desktop from fighting each other.
  //
  // How many covers make up a page is measured from the layout rather than
  // fixed, because the breakpoints disagree: desktop pages three at a time,
  // mobile advances one large cover at a time. Everything below derives from
  // that measurement, so one code path serves both and neither number is
  // written down here where it could drift from the CSS.
  (function () {
    function initPublications(carousel) {
      if (!carousel || carousel.dataset.fpbReady === 'true') return;

      var track = carousel.querySelector('.fpb__track');
      var items = carousel.querySelectorAll('.fpb__item');
      var prev = carousel.querySelector('.fpb__arrow--prev');
      var next = carousel.querySelector('.fpb__arrow--next');
      var section = carousel.closest('.fpb');
      var dots = section ? section.querySelectorAll('.fpb__dot') : [];
      var dotsRow = section ? section.querySelector('.fpb__dots') : null;

      if (!track || items.length === 0) return;
      carousel.dataset.fpbReady = 'true';

      // One cover plus one gutter. Measured rather than computed from the
      // settings so it stays correct at any viewport width, and re-measured
      // on resize because the covers are sized in percentages.
      function stride() {
        if (items.length < 2) return items[0].getBoundingClientRect().width;
        var a = items[0].getBoundingClientRect().left;
        var b = items[1].getBoundingClientRect().left;
        return b - a;
      }

      // Covers in view, from the track's own width — three on desktop, one on
      // mobile, without either number being stated here. Rounding rather than
      // flooring is what lands the mobile case on 1: the peeked cover is a
      // fraction of a stride, so 1.17 strides of track is one cover in view.
      function perPage() {
        var step = stride();
        if (step <= 0) return 1;
        return Math.max(1, Math.round(track.clientWidth / step));
      }

      function pageCount() {
        return Math.max(1, Math.ceil(items.length / perPage()));
      }

      function currentPage() {
        var pageWidth = stride() * perPage();
        if (pageWidth <= 0) return 0;
        var page = Math.round(track.scrollLeft / pageWidth);
        return Math.max(0, Math.min(pageCount() - 1, page));
      }

      function goToPage(page) {
        var clamped = Math.max(0, Math.min(pageCount() - 1, page));
        track.scrollTo({ left: clamped * stride() * perPage(), behavior: 'smooth' });
      }

      function sync() {
        var pages = pageCount();
        var page = currentPage();

        // Compared against the real scroll extent, not the page index, so a
        // final page short of a full set of covers still disables the arrow.
        var maxScroll = track.scrollWidth - track.clientWidth;
        if (prev) prev.disabled = track.scrollLeft <= 1;
        if (next) next.disabled = track.scrollLeft >= maxScroll - 1;

        // There is a dot per cover in the markup, but only the first `pages` of
        // them mean anything at this breakpoint — the rest are hidden rather
        // than left pointing at pages that don't exist.
        for (var i = 0; i < dots.length; i++) {
          var inRange = i < pages;
          var active = inRange && i === page;
          dots[i].hidden = !inRange;
          dots[i].classList.toggle('fpb__dot--active', active);
          dots[i].setAttribute('aria-selected', active ? 'true' : 'false');
        }

        // Everything fits in one page at this width, so there is nothing to
        // page between.
        if (dotsRow) dotsRow.hidden = pages < 2;
      }

      if (prev) {
        prev.addEventListener('click', function () {
          goToPage(currentPage() - 1);
        });
      }

      if (next) {
        next.addEventListener('click', function () {
          goToPage(currentPage() + 1);
        });
      }

      for (var d = 0; d < dots.length; d++) {
        dots[d].addEventListener('click', function (event) {
          goToPage(parseInt(event.currentTarget.dataset.page, 10) || 0);
        });
      }

      var frame = null;
      track.addEventListener(
        'scroll',
        function () {
          if (frame) return;
          frame = requestAnimationFrame(function () {
            frame = null;
            sync();
          });
        },
        { passive: true }
      );

      window.addEventListener('resize', sync);
      sync();
    }

    function initAll(root) {
      (root || document).querySelectorAll('.fpb__carousel').forEach(initPublications);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        initAll();
      });
    } else {
      initAll();
    }

    // The theme editor replaces a section's markup wholesale when a setting
    // changes, which drops every listener above with it.
    document.addEventListener('shopify:section:load', function (event) {
      initAll(event.target);
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Publications",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "In print"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Publications"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Covers shot for magazines and journals in the field."
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between covers",
      "info": "Applies on desktop and tablet, where three covers are in view. Phones show one cover at a time with a fixed gap.",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "cover_scale",
      "label": "Cover size",
      "info": "Desktop and tablet only. How much of its slot each cover fills — lower values make the covers smaller without changing how many are in view.",
      "min": 60,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 86
    },
    {
      "type": "range",
      "id": "mobile_cover_width",
      "label": "Mobile cover width",
      "info": "Phones only. How much of the screen width one cover fills. Whatever is left over becomes the peek of the next cover at the right edge, which is what shows there is more to swipe.",
      "min": 70,
      "max": 90,
      "step": 1,
      "unit": "%",
      "default": 82
    },
    {
      "type": "select",
      "id": "cover_ratio",
      "label": "Cover shape",
      "info": "Covers are never cropped — this sets the size of the frame each one sits in.",
      "options": [
        { "value": "3 / 4", "label": "Portrait" },
        { "value": "2 / 3", "label": "Tall portrait" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 3", "label": "Landscape" }
      ],
      "default": "3 / 4"
    }
  ],
  "blocks": [
    {
      "type": "publication",
      "name": "Publication",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Cover image",
          "info": "Add a Publication block for each new cover — the carousel pages to fit them. Up to 50, which is Shopify's limit per section."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Publication name",
          "info": "For example, Outdoor Photographer."
        },
        {
          "type": "text",
          "id": "issue",
          "label": "Issue",
          "info": "Optional. For example, March 2024."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link",
          "info": "Optional. Links the cover out to the publication."
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Publications",
      "blocks": [
        { "type": "publication" },
        { "type": "publication" },
        { "type": "publication" },
        { "type": "publication" },
        { "type": "publication" },
        { "type": "publication" }
      ]
    }
  ]
}
{% endschema %}

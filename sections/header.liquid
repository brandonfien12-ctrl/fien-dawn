{%- comment -%} ── Fien Studio navigation ──────────────────────────────────── {%- endcomment -%}

<nav
  class="fien-nav"
  id="fienNav"
  role="navigation"
  aria-label="{{ 'sections.fien_nav.aria_label' | t }}"
>
  <a href="{{ routes.root_url }}" class="fien-nav__logo">
    FIEN<span>STUDIOS</span>
  </a>

  {%- liquid
    assign has_menu = false
    if section.settings.menu != blank
      assign has_menu = true
    endif
  -%}
  {%- if has_menu or section.settings.portfolio_enable -%}
    <ul class="fien-nav__links" role="list">
      {%- if has_menu -%}
        {%- for link in linklists[section.settings.menu].links -%}
          <li>
            <a
              href="{{ link.url }}"
              class="fien-nav__link{% if link.active %} fien-nav__link--active{% endif %}"
              {% if link.active %}aria-current="page"{% endif %}
            >
              {{- link.title -}}
            </a>
          </li>
        {%- endfor -%}
      {%- endif -%}

      {%- if section.settings.portfolio_enable -%}
        <li class="fien-nav__dropdown" data-fien-dropdown>
          <button
            type="button"
            class="fien-nav__link fien-nav__dropdown-toggle"
            aria-haspopup="true"
            aria-expanded="false"
            data-fien-dropdown-toggle
          >
            {{- section.settings.portfolio_label -}}
            <span class="fien-nav__caret" aria-hidden="true"></span>
          </button>
          <ul class="fien-nav__submenu" role="list">
            {% render 'fien-portfolio-links',
              item_class: 'fien-nav__submenu-link',
              l1_label: section.settings.portfolio_link1_label,
              l1_url: section.settings.portfolio_link1_url,
              l2_label: section.settings.portfolio_link2_label,
              l2_url: section.settings.portfolio_link2_url,
              l3_label: section.settings.portfolio_link3_label,
              l3_url: section.settings.portfolio_link3_url
            %}
          </ul>
        </li>
      {%- endif -%}
    </ul>
  {%- endif -%}

  <div class="fien-nav__actions">

    {%- comment -%} Cart icon — id="cart-icon-bubble" is required by Dawn's cart-drawer.js {%- endcomment -%}
    <a
      href="{{ routes.cart_url }}"
      class="fien-nav__cart"
      id="cart-icon-bubble"
      aria-label="{{ 'templates.cart.cart' | t }}"
    >
      {%- if cart == empty -%}
        <span class="svg-wrapper">{{- 'icon-cart-empty.svg' | inline_asset_content -}}</span>
      {%- else -%}
        <span class="svg-wrapper">{{- 'icon-cart.svg' | inline_asset_content -}}</span>
      {%- endif -%}
      <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
      {%- if cart != empty -%}
        <div class="cart-count-bubble">
          {%- if cart.item_count < 100 -%}
            <span aria-hidden="true">{{ cart.item_count }}</span>
          {%- endif -%}
          <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
        </div>
      {%- endif -%}
    </a>

    <button
      class="fien-nav__hamburger"
      id="fienHamburger"
      aria-expanded="false"
      aria-controls="fienMobileNav"
      aria-label="{{ 'sections.fien_nav.menu_open' | t }}"
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>

  </div>
</nav>

{%- comment -%} ── Mobile full-screen overlay ──────────────────────────────── {%- endcomment -%}

<div
  class="fien-nav__mobile"
  id="fienMobileNav"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'sections.fien_nav.mobile_menu_label' | t }}"
>
  <button
    class="fien-nav__mobile-close"
    id="fienMobileClose"
    aria-label="{{ 'sections.fien_nav.menu_close' | t }}"
  >
    &times;
  </button>

  {%- if section.settings.menu != blank -%}
    <ul class="fien-nav__mobile-links" role="list">
      {%- for link in linklists[section.settings.menu].links -%}
        <li>
          <a
            href="{{ link.url }}"
            class="fien-nav__mobile-link"
            {% if link.active %}aria-current="page"{% endif %}
          >
            {{- link.title -}}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- comment -%} Portfolio dropdown — tap to expand on mobile (native details) {%- endcomment -%}
  {%- if section.settings.portfolio_enable -%}
    <details class="fien-nav__mobile-dropdown">
      <summary class="fien-nav__mobile-summary">
        {{- section.settings.portfolio_label -}}
      </summary>
      <ul class="fien-nav__mobile-sublinks" role="list">
        {% render 'fien-portfolio-links',
          item_class: 'fien-nav__mobile-link fien-nav__mobile-sublink',
          l1_label: section.settings.portfolio_link1_label,
          l1_url: section.settings.portfolio_link1_url,
          l2_label: section.settings.portfolio_link2_label,
          l2_url: section.settings.portfolio_link2_url,
          l3_label: section.settings.portfolio_link3_label,
          l3_url: section.settings.portfolio_link3_url
        %}
      </ul>
    </details>
  {%- endif -%}
</div>


<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {%- assign potential_action_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' -%}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

{% stylesheet %}
  /* ── Fien nav — fixed bar ──────────────────────────────────────────────── */

  .fien-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 60px;
    background: linear-gradient(to bottom, rgba(8,8,8,0.95), transparent);
    border-bottom: 1px solid transparent;
    transition: background 0.3s ease, border-color 0.3s ease, padding 0.3s ease;
  }

  .fien-nav.is-scrolled {
    background: rgba(8, 8, 8, 0.97);
    border-bottom-color: var(--border);
    padding-top: 16px;
    padding-bottom: 16px;
  }

  /* ── Logo ─────────────────────────────────────────────────────────────── */

  .fien-nav__logo {
    font-family: var(--font-display);
    font-size: 26px;
    letter-spacing: 0.12em;
    color: var(--white);
    text-decoration: none;
    line-height: 1;
    flex-shrink: 0;
  }

  .fien-nav__logo span {
    color: var(--gold);
  }

  /* ── Desktop links ────────────────────────────────────────────────────── */

  .fien-nav__links {
    display: flex;
    align-items: center;
    gap: 36px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .fien-nav__link {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    position: relative;
    transition: color 0.3s ease;
  }

  .fien-nav__link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s ease;
  }

  .fien-nav__link:hover,
  .fien-nav__link--active {
    color: var(--white);
  }

  .fien-nav__link:hover::after,
  .fien-nav__link--active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* ── Portfolio dropdown ───────────────────────────────────────────────── */

  .fien-nav__dropdown {
    position: relative;
  }

  .fien-nav__dropdown-toggle {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .fien-nav__caret {
    width: 6px;
    height: 6px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.3s ease;
    margin-top: -3px;
  }

  .fien-nav__dropdown:hover .fien-nav__caret,
  .fien-nav__dropdown:focus-within .fien-nav__caret,
  .fien-nav__dropdown.is-open .fien-nav__caret {
    transform: rotate(-135deg);
    margin-top: 2px;
  }

  .fien-nav__submenu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(-6px);
    min-width: 200px;
    margin: 14px 0 0;
    padding: 12px 0;
    list-style: none;
    background: var(--dark);
    border: 1px solid var(--border);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s ease;
    z-index: 200;
  }

  /* Invisible bridge so the pointer can cross the gap without closing */
  .fien-nav__submenu::before {
    content: '';
    position: absolute;
    top: -14px;
    left: 0;
    right: 0;
    height: 14px;
  }

  .fien-nav__dropdown:hover .fien-nav__submenu,
  .fien-nav__dropdown:focus-within .fien-nav__submenu,
  .fien-nav__dropdown.is-open .fien-nav__submenu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .fien-nav__submenu-link {
    display: block;
    padding: 10px 24px;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .fien-nav__submenu-link:hover {
    color: var(--gold);
    background: var(--mid);
  }

  /* ── Right-side actions (cart + hamburger) ────────────────────────────── */

  .fien-nav__actions {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-shrink: 0;
  }

  /* ── Cart icon ─────────────────────────────────────────────────────────── */

  .fien-nav__cart {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--white);
    text-decoration: none;
    transition: color 0.2s ease;
    flex-shrink: 0;
    line-height: 0;
  }

  .fien-nav__cart:hover {
    color: var(--gold);
  }

  .fien-nav__cart .svg-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fien-nav__cart .icon-cart,
  .fien-nav__cart .icon-cart-empty {
    width: 22px;
    height: 22px;
  }

  /* ── Cart count bubble ────────────────────────────────────────────────── */

  .fien-nav__cart .cart-count-bubble {
    position: absolute;
    top: -5px;
    right: -8px;
    background: var(--gold);
    color: #080808;
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 600;
    line-height: 1;
    min-width: 16px;
    height: 16px;
    width: auto;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    /* reset Dawn's base.css positioning */
    bottom: auto;
    left: auto;
  }

  /* ── Hamburger (mobile only) ──────────────────────────────────────────── */

  .fien-nav__hamburger {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 24px;
    height: 18px;
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    flex-shrink: 0;
  }

  .fien-nav__hamburger span {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--white);
  }

  /* ── Mobile full-screen overlay ───────────────────────────────────────── */

  .fien-nav__mobile {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(8, 8, 8, 0.97);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-6px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .fien-nav__mobile.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .fien-nav__mobile-close {
    position: absolute;
    top: 24px;
    right: 24px;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--muted);
    width: 44px;
    height: 44px;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.3s ease, color 0.3s ease;
  }

  .fien-nav__mobile-close:hover {
    border-color: var(--gold);
    color: var(--gold);
  }

  .fien-nav__mobile-links {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .fien-nav__mobile-link {
    font-family: var(--font-display);
    font-size: clamp(40px, 8vw, 64px);
    letter-spacing: 0.06em;
    color: var(--white);
    text-decoration: none;
    display: block;
    padding: 10px 0;
    transition: color 0.3s ease;
  }

  .fien-nav__mobile-link:hover {
    color: var(--gold);
  }

  .fien-nav__mobile-dropdown {
    text-align: center;
    margin-top: 4px;
  }

  .fien-nav__mobile-summary {
    font-family: var(--font-display);
    font-size: clamp(40px, 8vw, 64px);
    letter-spacing: 0.06em;
    color: var(--white);
    padding: 10px 0;
    cursor: pointer;
    list-style: none;
    transition: color 0.3s ease;
  }

  .fien-nav__mobile-summary::-webkit-details-marker {
    display: none;
  }

  .fien-nav__mobile-summary:hover {
    color: var(--gold);
  }

  .fien-nav__mobile-sublinks {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .fien-nav__mobile-sublink {
    font-size: clamp(22px, 5vw, 32px);
    color: var(--muted);
  }

  /* ── Mobile breakpoint ────────────────────────────────────────────────── */

  @media screen and (max-width: 749px) {
    .fien-nav {
      padding: 20px 24px;
    }

    .fien-nav.is-scrolled {
      padding: 14px 24px;
    }

    .fien-nav__links {
      display: none;
    }

    .fien-nav__hamburger {
      display: flex;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var nav       = document.getElementById('fienNav');
    var hamburger = document.getElementById('fienHamburger');
    var mobileNav = document.getElementById('fienMobileNav');
    var closeBtn  = document.getElementById('fienMobileClose');

    // ── Scroll state ────────────────────────────────────────────────────
    function onScroll() {
      nav.classList.toggle('is-scrolled', window.scrollY > 60);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // ── Mobile menu ──────────────────────────────────────────────────────
    function openMenu() {
      mobileNav.classList.add('is-open');
      mobileNav.setAttribute('aria-hidden', 'false');
      hamburger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      mobileNav.classList.remove('is-open');
      mobileNav.setAttribute('aria-hidden', 'true');
      hamburger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    if (hamburger) hamburger.addEventListener('click', openMenu);
    if (closeBtn)  closeBtn.addEventListener('click', closeMenu);

    // Close on any mobile link click (navigation is happening)
    if (mobileNav) {
      mobileNav.querySelectorAll('.fien-nav__mobile-link').forEach(function (link) {
        link.addEventListener('click', closeMenu);
      });
    }

    // ── Portfolio dropdown ───────────────────────────────────────────────
    // Hover / keyboard focus opens it via CSS; this adds click-and-tap toggle
    // plus outside-click and Escape to close.
    var dropdowns = nav.querySelectorAll('[data-fien-dropdown]');

    function closeDropdowns() {
      dropdowns.forEach(function (dd) {
        dd.classList.remove('is-open');
        var t = dd.querySelector('[data-fien-dropdown-toggle]');
        if (t) t.setAttribute('aria-expanded', 'false');
      });
    }

    dropdowns.forEach(function (dd) {
      var toggle = dd.querySelector('[data-fien-dropdown-toggle]');
      if (!toggle) return;
      toggle.addEventListener('click', function (event) {
        event.preventDefault();
        var isOpen = dd.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    });

    document.addEventListener('click', function (event) {
      dropdowns.forEach(function (dd) {
        if (!dd.contains(event.target)) {
          dd.classList.remove('is-open');
          var t = dd.querySelector('[data-fien-dropdown-toggle]');
          if (t) t.setAttribute('aria-expanded', 'false');
        }
      });
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') closeDropdowns();
    });
  })();
{% endjavascript %}


{%- liquid
  if section.settings.collection != blank
    assign featured_collection = collections[section.settings.collection]
  else
    assign featured_collection = collections.all
  endif
-%}

<section class="fpc">

  {%- comment -%} Section header {%- endcomment -%}
  <div class="fpc__header">
    <p class="fpc__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="fpc__heading">{{ section.settings.heading }}</h2>
    <p class="fpc__subtitle">{{ section.settings.subtitle }}</p>
  </div>

  {%- comment -%} Product grid {%- endcomment -%}
  {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
    <ul class="fpc__grid" role="list">
      {%- for product in featured_collection.products limit: section.settings.products_to_show -%}
        <li class="fpc-card">

          {%- comment -%} Image {%- endcomment -%}
          <a href="{{ product.url }}" class="fpc-card__image-link" aria-label="{{ product.title | escape }}">
            <div class="fpc-card__image-wrap">
              {%- if product.featured_image != blank -%}
                {{
                  product.featured_image
                  | image_url: width: 800
                  | image_tag:
                    class: 'fpc-card__image',
                    loading: 'lazy',
                    widths: '400, 600, 800',
                    alt: product.featured_image.alt | default: product.title | escape
                }}
              {%- else -%}
                <div class="fpc-card__image-placeholder" aria-hidden="true"></div>
              {%- endif -%}
            </div>
          </a>

          {%- comment -%} Card body {%- endcomment -%}
          <div class="fpc-card__body">
            <h3 class="fpc-card__title">{{ product.title }}</h3>

            <p class="fpc-card__edition">
              {{- 'sections.fien_featured_prints.edition_label' | t -}}
            </p>

            {%- comment -%} Format tags from first product option {%- endcomment -%}
            {%- if product.options_with_values.size > 0 -%}
              <div class="fpc-card__formats">
                {%- for value in product.options_with_values[0].values -%}
                  <span class="fpc-card__format-tag">{{ value }}</span>
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- comment -%} Price row {%- endcomment -%}
            <div class="fpc-card__price-row">
              <div class="fpc-card__price">
                <span class="fpc-card__price-from">
                  {{- 'sections.fien_featured_prints.from' | t -}}
                </span>
                {{ product.price_min | money_without_trailing_zeros }}
              </div>
            </div>

            {%- comment -%} CTA {%- endcomment -%}
            <a href="{{ product.url }}" class="fpc-btn">
              {{- 'sections.fien_featured_prints.select_options' | t -}}
            </a>
          </div>

        </li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <p class="fpc__empty">{{ 'sections.fien_featured_prints.no_products' | t }}</p>
  {%- endif -%}

</section>

{% stylesheet %}
  /* ── Featured prints section ──────────────────────────────────────────── */

  .fpc {
    background: var(--deep);
    padding: 120px 60px;
  }

  /* ── Section header ───────────────────────────────────────────────────── */

  .fpc__header {
    margin-bottom: 64px;
    max-width: 700px;
  }

  .fpc__eyebrow {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 16px;
  }

  .fpc__heading {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 64px);
    letter-spacing: 0.06em;
    line-height: 1;
    color: var(--white);
    margin: 0 0 24px;
  }

  .fpc__subtitle {
    font-family: var(--font-serif);
    font-size: 18px;
    font-style: italic;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.8;
    margin: 0;
  }

  /* ── Grid ─────────────────────────────────────────────────────────────── */

  .fpc__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ── Card ─────────────────────────────────────────────────────────────── */

  .fpc-card {
    background: var(--dark);
    border: 1px solid var(--border);
    overflow: hidden;
    position: relative;
    z-index: 0;
    transition: border-color 0.3s ease, transform 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .fpc-card:hover {
    border-color: rgba(201, 168, 76, 0.3);
    transform: translateY(-4px);
    z-index: 1;
  }

  /* ── Card image ───────────────────────────────────────────────────────── */

  .fpc-card__image-link {
    display: block;
    overflow: hidden;
  }

  .fpc-card__image-wrap {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--mid);
  }

  .fpc-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .fpc-card:hover .fpc-card__image {
    transform: scale(1.03);
  }

  .fpc-card__image-placeholder {
    width: 100%;
    height: 100%;
    background: var(--mid);
  }

  /* ── Card body ────────────────────────────────────────────────────────── */

  .fpc-card__body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .fpc-card__title {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 300;
    color: var(--white);
    margin: 0 0 6px;
    line-height: 1.3;
  }

  .fpc-card__edition {
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 16px;
  }

  /* ── Format tags ──────────────────────────────────────────────────────── */

  .fpc-card__formats {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .fpc-card__format-tag {
    padding: 4px 10px;
    border: 1px solid var(--border);
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ── Price ────────────────────────────────────────────────────────────── */

  .fpc-card__price-row {
    margin-top: auto;
    margin-bottom: 16px;
  }

  .fpc-card__price {
    font-family: var(--font-display);
    font-size: 24px;
    letter-spacing: 0.05em;
    color: var(--gold);
    line-height: 1;
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .fpc-card__price-from {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 300;
    color: var(--muted);
    letter-spacing: 0.05em;
  }

  /* ── CTA button ───────────────────────────────────────────────────────── */

  .fpc-btn {
    display: block;
    width: 100%;
    padding: 14px;
    background: var(--gold);
    color: #080808;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    transition: background 0.3s ease;
    box-sizing: border-box;
  }

  .fpc-btn:hover {
    background: var(--gold-light);
  }

  /* ── Empty state ──────────────────────────────────────────────────────── */

  .fpc__empty {
    font-family: var(--font-serif);
    font-size: 18px;
    font-style: italic;
    color: var(--muted);
    text-align: center;
    padding: 60px 0;
  }

  /* ── Mobile ───────────────────────────────────────────────────────────── */

  @media screen and (max-width: 749px) {
    .fpc {
      padding: 80px 24px;
    }

    .fpc__grid {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured prints",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "The collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Fine art prints"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Each image is produced in a limited edition of 50. Printed to order."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 3,
      "max": 24,
      "step": 1,
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Featured prints"
    }
  ]
}
{% endschema %}

{%- comment -%}
  ---------------------------------------------------------------------------
  LIGHTWEIGHT CLIENT-SIDE GATE — NOT REAL SECURITY.

  The password is compared in the browser and is present in the page source,
  so anyone who inspects the page can read it. This is only meant to keep a
  portfolio's client area lightly private (out of casual view and off search
  engines). Do NOT use it to protect anything sensitive — for real protection
  use Shopify customer accounts or a server-side password.
  ---------------------------------------------------------------------------
{%- endcomment -%}

<section
  class="client-gate"
  id="client-gate-{{ section.id }}"
  data-client-gate
  data-storage-key="client-gate:{{ section.id }}"
  data-password="{{ section.settings.password | escape }}"
>
  {%- comment -%} Lock screen {%- endcomment -%}
  <div class="client-gate__lock" data-client-gate-lock>
    {%- if section.settings.heading != blank -%}
      <h1 class="client-gate__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <div class="client-gate__intro rte">{{ section.settings.intro }}</div>
    {%- endif -%}

    <form class="client-gate__form" data-client-gate-form>
      <label class="visually-hidden" for="client-gate-input-{{ section.id }}">
        {{ section.settings.placeholder | default: section.settings.heading }}
      </label>
      <input
        class="client-gate__input"
        type="password"
        id="client-gate-input-{{ section.id }}"
        name="client_gate_password"
        placeholder="{{ section.settings.placeholder | escape }}"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        required
      >
      <button type="submit" class="fien-btn fien-btn--primary">
        {{- section.settings.button_label -}}
      </button>
      <p class="client-gate__error" data-client-gate-error hidden>
        {{ section.settings.error_message }}
      </p>
    </form>
  </div>

  {%- comment -%} Gated content — revealed only after a correct password {%- endcomment -%}
  <div class="client-gate__content" data-client-gate-content hidden>
    {%- for block in section.blocks -%}
      <div class="client-gate__block" {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when 'media' -%}
            {% render 'fien-media-item',
              image: block.settings.image,
              video: block.settings.video,
              video_url: block.settings.video_url,
              title: block.settings.title,
              caption: block.settings.caption
            %}
          {%- when 'text' -%}
            <div class="client-gate__text rte">{{ block.settings.text }}</div>
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .client-gate {
    background: var(--black);
    padding: 120px 60px;
  }

  .client-gate__lock {
    max-width: 480px;
    margin: 0 auto;
    text-align: center;
  }

  .client-gate__heading {
    font-family: var(--font-display);
    font-size: clamp(48px, 8vw, 96px);
    line-height: 0.95;
    letter-spacing: 0.04em;
    color: var(--white);
    margin: 0 0 20px;
  }

  .client-gate__intro {
    font-family: var(--font-serif);
    font-size: clamp(16px, 1.6vw, 20px);
    font-style: italic;
    color: var(--muted);
    margin: 0 0 32px;
    line-height: 1.7;
  }

  .client-gate__form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
  }

  .client-gate__input {
    width: 100%;
    background: var(--mid);
    border: 1px solid var(--border);
    color: var(--white);
    font-family: var(--font-sans);
    font-size: 14px;
    letter-spacing: 0.05em;
    padding: 14px 18px;
    text-align: center;
  }

  .client-gate__input:focus {
    outline: none;
    border-color: var(--gold);
  }

  .client-gate__error {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #e0736b;
    margin: 0;
  }

  .client-gate__content {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .client-gate__block--wide,
  .client-gate__text {
    grid-column: 1 / -1;
  }

  .client-gate__text {
    font-family: var(--font-serif);
    font-size: clamp(16px, 1.6vw, 20px);
    line-height: 1.8;
    color: var(--white);
  }

  @media screen and (max-width: 749px) {
    .client-gate {
      padding: 80px 24px;
    }

    .client-gate__content {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% javascript %}
  // Lightweight client-side gate — see the Liquid comment at the top of this
  // section. This is NOT authentication; the password is readable in the page
  // source. Suitable for a portfolio client area only.
  function initClientGate(gate) {
    var lock = gate.querySelector('[data-client-gate-lock]');
    var content = gate.querySelector('[data-client-gate-content]');
    var form = gate.querySelector('[data-client-gate-form]');
    var error = gate.querySelector('[data-client-gate-error]');
    var input = gate.querySelector('.client-gate__input');
    var password = gate.getAttribute('data-password') || '';
    var storageKey = gate.getAttribute('data-storage-key');

    function unlock() {
      if (lock) lock.hidden = true;
      if (content) content.hidden = false;
    }

    // Restore the unlocked state for this session.
    try {
      if (storageKey && sessionStorage.getItem(storageKey) === 'unlocked') {
        unlock();
      }
    } catch (e) {
      // sessionStorage may be unavailable (e.g. private mode) — fail closed.
    }

    if (!form) return;

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      var value = input ? input.value.trim() : '';

      if (value === password && password !== '') {
        try {
          if (storageKey) sessionStorage.setItem(storageKey, 'unlocked');
        } catch (e) {
          // Ignore storage failures — the content still unlocks for this view.
        }
        unlock();
      } else if (error) {
        error.hidden = false;
        if (input) {
          input.value = '';
          input.focus();
        }
      }
    });
  }

  function initAllClientGates() {
    document.querySelectorAll('[data-client-gate]').forEach(initClientGate);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAllClientGates);
  } else {
    initAllClientGates();
  }
{% endjavascript %}

{% schema %}
{
  "name": "Client gate",
  "settings": [
    {
      "type": "header",
      "content": "Password"
    },
    {
      "type": "text",
      "id": "password",
      "label": "Password",
      "info": "Lightweight client-side gate only — the password is visible in the page source. Do not use it to protect sensitive files.",
      "default": "fien2026"
    },
    {
      "type": "header",
      "content": "Lock screen"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Client page"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>Enter the password provided to view your gallery.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Password"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Enter"
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Error message",
      "default": "Incorrect password. Please try again."
    }
  ],
  "max_blocks": 50,
  "blocks": [
    {
      "type": "media",
      "name": "Media",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (uploaded)"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "Video URL (YouTube or Vimeo)",
          "accept": ["youtube", "vimeo"]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title (optional)"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption (optional)"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Share a note with your client here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Client gate",
      "blocks": [
        { "type": "text" },
        { "type": "media" },
        { "type": "media" }
      ]
    }
  ]
}
{% endschema %}
